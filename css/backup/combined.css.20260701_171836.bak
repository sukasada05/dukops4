/* ========================================== */ 
/*   File: download-png.css                                */ 
/* ========================================== */ 
/* download-png.css - CSS untuk halaman download absen PNG */

/* Container utama untuk area screenshot */
.png-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 15px;
    background: #ffffff;
    border-radius: 12px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
}

/* Header PNG */
.png-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px 10px 16px;
    background: linear-gradient(135deg, #1a2332, #2c3e50);
    border-radius: 10px 10px 0 0;
    color: white;
}

.png-header div:first-child {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.png-header div:last-child {
    font-size: 8px;
    opacity: 0.7;
}

/* Stats grid untuk PNG */
.png-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin: 8px 0 10px 0;
}

.png-stat-card {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 8px 4px;
    text-align: center;
    border: 1px solid #e9ecef;
}

.png-stat-card div:first-child {
    font-size: 12px;
    font-weight: 700;
}

.png-stat-card div:last-child {
    font-size: 7px;
    color: #6b7a8f;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

/* Progress bar PNG */
.png-progress-bar {
    width: 100%;
    height: 6px;
    background: #e9ecef;
    border-radius: 4px;
    overflow: hidden;
    margin: 2px 0;
}

.png-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #4CAF50, #66BB6A);
    border-radius: 4px;
    transition: width 0.5s ease;
}

/* Item desa untuk PNG */
.png-desa-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px;
    border-bottom: 1px solid #f0f2f5;
    font-size: 10px;
}

.png-desa-item:last-child {
    border-bottom: none;
}

.png-desa-item .desa-name {
    flex: 2;
    font-weight: 500;
    color: #000;
    font-size: 10px;
}

.png-desa-item .desa-count {
    width: 35px;
    text-align: center;
    font-size: 9px;
    color: #000;
}

.png-desa-item .desa-progress {
    width: 50px;
}

.png-desa-item .desa-progress-bar {
    background: #e0e0e0;
    border-radius: 6px;
    height: 4px;
    overflow: hidden;
}

.png-desa-item .desa-progress-fill {
    height: 4px;
    border-radius: 6px;
}

.png-desa-item .desa-status {
    width: 45px;
    text-align: center;
    font-size: 8px;
    padding: 2px 4px;
    border-radius: 8px;
    font-weight: 600;
}

/* Status badge untuk PNG */
.png-status-lengkap {
    background: #e8f5e9;
    color: #4caf50;
}

.png-status-bl {
    background: #fff3e0;
    color: #ff9800;
}

.png-status-belum {
    background: #ffebee;
    color: #f44336;
}

/* Footer PNG */
.png-footer {
    text-align: center;
    padding: 8px 0 4px 0;
    font-size: 7px;
    color: #999;
    border-top: 1px solid #f0f2f5;
    margin-top: 8px;
}

/* Style untuk tombol download di halaman absen */
.absen-btn-download-png {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #e91e63, #c2185b);
    color: white;
    border: none;
    padding: 10px 24px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(233, 30, 99, 0.3);
    margin: 10px 0;
}

.absen-btn-download-png:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(233, 30, 99, 0.4);
}

.absen-btn-download-png:active {
    transform: translateY(0);
}

.absen-btn-download-png i {
    font-size: 18px;
}

/* Responsif untuk PNG */
@media (max-width: 480px) {
    .png-container {
        padding: 10px;
        max-width: 100%;
    }
    
    .png-stats {
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
    }
    
    .png-stat-card {
        padding: 5px 2px;
    }
    
    .png-stat-card div:first-child {
        font-size: 10px;
    }
    
    .png-stat-card div:last-child {
        font-size: 6px;
    }
    
    .png-desa-item {
        padding: 4px 4px;
        font-size: 8px;
        gap: 4px;
    }
    
    .png-desa-item .desa-name {
        font-size: 8px;
    }
    
    .png-desa-item .desa-count {
        font-size: 7px;
        width: 28px;
    }
    
    .png-desa-item .desa-progress {
        width: 35px;
    }
    
    .png-desa-item .desa-status {
        font-size: 6px;
        width: 35px;
        padding: 1px 3px;
    }
    
    .png-header div:first-child {
        font-size: 12px;
    }
    
    .png-header div:last-child {
        font-size: 6px;
    }
}

/* Print style untuk PNG */
@media print {
    .png-container {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
        max-width: 100% !important;
    }
    
    .png-header {
        background: #1a2332 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
    
    .png-stat-card {
        background: #f8f9fa !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
    
    .png-progress-fill {
        background: #4CAF50 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
    
    .png-status-lengkap,
    .png-status-bl,
    .png-status-belum {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
}
 
/* ===== End of download-png.css ===== */ 
 
 
/* ========================================== */ 
/*   File: form.css                                */ 
/* ========================================== */ 
/* ================================================================
   FORM.CSS - FORM ELEMENTS
   ================================================================ */

label {
    display: block;
    margin-top: 16px;
    font-weight: 600;
    color: #effb04;
    font-size: 20px;
    letter-spacing: 0.5px;
}

label i {
    color: #ffffff;
    margin-right: 6px;
}

select,
input,
textarea {
    width: 100%;
    padding: 10px 14px;
    margin-top: 6px;
    border-radius: 10px;
    border: 1px solid rgba(76, 175, 80, 0.12);
    background: rgba(0, 0, 0, 0.3);
    color: #e6ffe6;
    font-size: 14px;
    transition: all 0.3s ease;
    font-family: 'Segoe UI', Arial, sans-serif;
}

select:focus,
input:focus,
textarea:focus {
    outline: none;
    border-color: #4CAF50;
    box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.08);
}

select option {
    background: #0a1a0a;
    color: #e6ffe6;
    padding: 8px;
}

textarea {
    min-height: 120px;
    resize: vertical;
    line-height: 1.6;
}

.narasi-wrapper {
    position: relative;
    margin-top: 6px;
}

.narasi-wrapper textarea {
    margin-top: 0;
    padding-right: 50px;
    min-height: 150px;
}

.ai-template-container {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 10px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.04);
}

.ai-template-container span {
    font-size: 12px;
    color: #889988;
    letter-spacing: 0.3px;
}

.ai-template-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #1a4a2a, #2d6a3d);
    border: none;
    padding: 8px 18px;
    border-radius: 30px;
    color: #fff;
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 0;
    width: auto;
    font-family: 'Segoe UI', Arial, sans-serif;
    border: 1px solid rgba(46, 204, 113, 0.15);
}

.ai-template-btn i {
    font-size: 15px;
    color: #2ecc71;
}

.ai-template-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(46, 204, 113, 0.15);
    background: linear-gradient(135deg, #2d6a3d, #3d8a4d);
}

.ai-template-btn:active {
    transform: scale(0.96);
}

.row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 10px;
}

.col {
    flex: 1;
    min-width: 0;
}

.previewBox {
    font-size: 13px;
    color: #889988;
    margin-top: 6px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    min-height: 2em;
}

canvas {
    display: block;
    margin-top: 16px;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: #000;
}

.app-loading {
    text-align: center;
    padding: 20px;
    color: #4dff4d;
    display: none;
    font-weight: 600;
}

.auto-height-textarea {
    width: 100%;
    padding: 10px 14px;
    margin-top: 6px;
    border-radius: 10px;
    border: 1px solid rgba(76, 175, 80, 0.12);
    background: rgba(0, 0, 0, 0.3);
    color: #e6ffe6;
    font-size: 14px;
    font-family: 'Segoe UI', Arial, sans-serif;
    resize: none;
    overflow-y: hidden;
    transition: height 0.1s ease;
    line-height: 1.6;
}

.auto-height-textarea:focus {
    outline: none;
    border-color: #4CAF50;
    box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.08);
}

/* ================================================================
   TELEGRAM GROUP SELECTOR - DIHAPUS
   ================================================================ */ 
/* ===== End of form.css ===== */ 
 
 
/* ========================================== */ 
/*   File: header.css                                */ 
/* ========================================== */ 
/* ================================================================
   HEADER.CSS - HEADER + ANNOUNCEMENT + RUNNING TEXT
   ================================================================ */

.dukops-header {
    background: url('header/header-background.png') center/cover no-repeat;
    background-color: #0d1f0d;
    border-radius: 16px;
    border: 1px solid rgba(255, 215, 0, 0.12);
    padding: 16px 20px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.dukops-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #FFD700, #FFA500, #FFD700, transparent);
    animation: headerGoldLine 3s ease-in-out infinite;
    background-size: 200% 100%;
}

@keyframes headerGoldLine {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}

.dukops-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.15), transparent);
}

.dukops-header-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
}

.dukops-profile-area {
    flex-shrink: 0;
    text-align: center;
    background: rgba(255, 255, 255, 0.04);
    padding: 8px;
    border-radius: 16px;
    width: 100px;
    border: 1px solid rgba(255, 215, 0, 0.08);
    transition: all 0.3s ease;
}

.dukops-profile-area:hover {
    border-color: rgba(144, 241, 7, 0.903)03));
    box-shadow: 0 0 30px rgba(255, 215, 0, 0.05);
}

.dukops-profile-img {
    width: 100%;
    height: 85px;
    border-radius: 12px;
    border: 2px solid rgba(255, 215, 0, 0.12);
    object-fit: cover;
    background: linear-gradient(135deg, #0d1f0d, #1a3a1a);
    transition: all 0.3s ease;
}

.dukops-profile-img:hover {
    border-color: #FFD700;
    transform: scale(1.02);
}

.dukops-profile-name {
    font-size: 10px;
    font-weight: 600;
    color: #FFD700;
    margin-top: 6px;
    letter-spacing: 0.5px;
    opacity: 0.8;
}

.dukops-title-area {
    flex: 1;
    min-width: 180px;
}

.dukops-header-title {
    font-size: 18px;
    font-weight: 700;
    color: #FFD700;
    margin: 1px 0;
    letter-spacing: 1px;
    text-shadow: 0 0 20px rgba(255, 215, 0, 0.08);
}

.dukops-header-title:last-of-type {
    font-size: 14px;
    color: #FFC107;
    font-weight: 600;
}

.dukops-header-address {
    font-size: 10px;
    color: #88dd88;
    margin-top: 4px;
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 6px;
}

.dukops-header-address i {
    color: #FFD700;
    font-size: 11px;
}

.audio-control-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    background: rgba(0, 0, 0, 0.3);
    padding: 4px 12px 4px 8px;
    border-radius: 30px;
    border: 1px solid rgba(255, 215, 0, 0.06);
}

.audio-control-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.05);
    color: #ddeedd;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 13px;
}

.audio-control-btn:hover {
    background: rgba(255, 215, 0, 0.12);
    color: #FFD700;
    transform: scale(1.05);
}

.audio-volume-slider {
    display: none;
    width: 80px;
    height: 3px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    outline: none;
}

.audio-volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #FFD700;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(255, 215, 0, 0.2);
}

.counter-value {
    font-size: 36px;
    font-weight: 700;
    color: #FFD700;
    background: transparent !important;  /* ← TRANSPARAN */
    padding: 2px 14px;
    border-radius: 20px;
    border: 1px solid rgba(255, 215, 0, 0.08);
    font-family: 'Courier New', monospace;
    min-width: 30px;
    text-align: center;
}

/* ================================================================
   TELEGRAM RUNNING TEXT - DIHAPUS
   ================================================================ */

.running-text-container {
    background: rgba(0, 30, 0, 0.4);
    border-radius: 12px;
    padding: 10px 16px;
    margin: 10px 0;
    border: 1px solid rgba(255, 204, 0, 0.08);
    overflow: hidden;
    white-space: nowrap;
    backdrop-filter: blur(4px);
}

.running-text {
    display: inline-block;
    white-space: nowrap;
    animation: marquee 12s linear infinite;
    color: #FFD700;
    font-weight: 600;
    font-size: 13px;
    padding-right: 50px;
}

@keyframes marquee {
    0% { transform: translateX(100%); }
    50% { transform: translateX(0%); }
    100% { transform: translateX(-100%); }
}

.running-text-container:hover .running-text {
    animation-play-state: paused;
}

.dukops-announcement-bar {
    width: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.03), transparent);
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 215, 0, 0.04);
    font-size: 13px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
}

.dukops-announcement-text {
    display: inline-block;
    padding-left: 100%;
    animation: dukops-running-text 35s linear infinite;
    color: #88dd88;
    letter-spacing: 0.5px;
}

@keyframes dukops-running-text {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
} 
/* ===== End of header.css ===== */ 
 
 
/* ========================================== */ 
/*   File: jadwal.css                                */ 
/* ========================================== */ 
/* ================================================================
   JADWAL.CSS - JADWAL PIKET (FULL UPGRADE - SIAP PAKAI)
   ================================================================ */

.jadwal-header {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.jadwal-title {
    color: #FFD700;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 8px;
    text-shadow: 0 0 30px rgba(255, 215, 0, 0.05);
}

.jadwal-logo {
    max-width: 100%;
    height: auto;
    max-height: 80px;
    border-radius: 12px;
    border: 1px solid rgba(76, 175, 80, 0.1);
    margin-bottom: 8px;
}

.jadwal-header p {
    font-size: 12px;
    color: #889988;
    letter-spacing: 0.5px;
}

.jadwal-section {
    background: rgba(0, 40, 0, 0.3);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 14px;
    border: 1px solid rgba(76, 175, 80, 0.06);
    backdrop-filter: blur(4px);
    transition: all 0.3s ease;
}

.jadwal-section:hover {
    border-color: rgba(76, 175, 80, 0.1);
}

/* ================================================================
   SUPERPOWER CENTER - SEMUA LABEL PASTI TENGAH
   (kecuali textarea preview, biar rata kiri)
   ================================================================ */
.jadwal-section,
.jadwal-section *,
.jadwal-section h3,
.jadwal-section p,
.jadwal-section div,
.jadwal-section span,
.jadwal-section label,
.jadwal-section li,
.section-title-koramil,
.section-title-kediaman,
.section-title-makodim {
    text-align: center !important;
}

/* ================================================================
   HEADING JADWAL - STYLE UPGRADE
   ================================================================ */
.jadwal-section h3 {
    margin: 8px 0 12px 0 !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    letter-spacing: 1px !important;
    text-align: center !important;
    text-transform: uppercase;
    display: block !important;
    width: 100% !important;
}

/* ================================================================
   WARNA LABEL DIBEDAKAN TAJAM (DENGAN GLOW)
   ================================================================ */

/* 🟢 PIKET KORAMIL - HIJAU TERANG */
.section-title-koramil,
h3.section-title-koramil {
    color: #4dff4d !important;
    text-shadow: 0 0 15px rgba(77, 255, 77, 0.4);
}

/* 🟡 JAGA KEDIAMAN - EMAS */
.section-title-kediaman,
h3.section-title-kediaman {
    color: #FFD700 !important;
    text-shadow: 0 0 15px rgba(255, 215, 0, 0.4);
}

/* 🔵 PIKET MAKODIM - BIRU ELEKTRIK */
.section-title-makodim,
h3.section-title-makodim {
    color: #00ccff !important;
    text-shadow: 0 0 15px rgba(0, 204, 255, 0.4);
}

/* ================================================================
   ROW DAN COL UNTUK SELECT (TETAP RAPI)
   ================================================================ */
.jadwal-section .section-content {
    display: block;
    width: 100%;
}

.jadwal-section .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 6px;
}

.jadwal-section .col {
    flex: 1 1 140px;
    max-width: 200px;
    text-align: center;
}

.jadwal-section select {
    width: 100%;
    padding: 10px 12px;
    border-radius: 10px;
    background: #0f1f0f;
    color: #e0ffe0;
    border: 1px solid rgba(76, 175, 80, 0.25);
    font-size: 13px;
    cursor: pointer;
    outline: none;
}

/* ================================================================
   BOX OUTPUT PESAN (PREVIEW) - FONT ARIAL
   ================================================================ */
#j_hasilPesanBaru {
    width: 100%;
    min-height: 200px;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid rgba(0, 136, 204, 0.08);
    background: rgba(0, 0, 0, 0.3);
    color: #ddeedd;
    font-family: 'Arial', sans-serif !important;
    font-size: 13px;
    line-height: 1.7;
    resize: vertical;
    margin-top: 10px;
    white-space: pre-wrap;
    overflow-y: auto;
    text-align: left !important;
}

#j_hasilPesanBaru:focus {
    outline: none;
    border-color: rgba(0, 136, 204, 0.2);
}

/* ================================================================
   RESPONSIVE - MOBILE
   ================================================================ */
@media (max-width: 600px) {
    .jadwal-section {
        padding: 12px;
        margin-bottom: 10px;
    }
    .jadwal-section h3 {
        font-size: 14px !important;
    }
    .jadwal-title {
        font-size: 18px;
    }
    .jadwal-section .col {
        min-width: 120px;
    }
} 
/* ===== End of jadwal.css ===== */ 
 
 
/* ========================================== */ 
/*   File: main.css                                */ 
/* ========================================== */ 
/* ================================================================
   MAIN.CSS - IMPORT SEMUA FILE CSS
   ================================================================ */

@import url('base.css');
@import url('splash.css');
@import url('header.css');
@import url('navigation.css');
@import url('form.css');
@import url('buttons.css');
@import url('notification.css');
@import url('jadwal.css');
@import url('attendance.css');
@import url('tab-absen.css');
@import url('popup.css');
@import url('responsive.css');

/* ===== FILE-FILE BARU ===== */
@import url('slider-volume.css');
@import url('announcement.css');
@import url('action-buttons.css');
@import url('thankyou-popup.css');
