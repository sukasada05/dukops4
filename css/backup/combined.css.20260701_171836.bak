/* ================================================================
   RESPONSIVE.CSS - RESPONSIVE
   ================================================================ */

@media (max-width: 768px) {
    .container {
        padding: 14px;
        border-radius: 14px;
        margin: 10px;
    }
    
    .dukops-header-row {
        flex-direction: column;
        text-align: center;
        gap: 12px;
    }
    
    .dukops-title-area {
        text-align: center;
    }
    
    .dukops-profile-area {
        width: 80px;
    }
    
    .dukops-profile-img {
        height: 70px;
    }
    
    .dukops-header-title {
        font-size: 16px;
    }
    
    .dukops-header-title:last-of-type {
        font-size: 13px;
    }
    
    .nav-buttons {
        gap: 6px;
        padding: 4px;
    }
    
    .nav-btn {
        font-size: 11px;
        padding: 10px 12px;
    }
    
    .nav-btn i {
        font-size: 14px;
    }
    
    .absen-stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .splash-title-center {
        font-size: 26px;
    }
    
    .splash-title-center:last-of-type {
        font-size: 18px;
    }
    
    .thankyou-content {
        padding: 24px;
        width: 92%;
    }
}

@media (max-width: 480px) {
    .container {
        padding: 10px;
        border-radius: 12px;
        margin: 6px;
    }
    
    .dukops-header {
        padding: 12px 14px;
    }
    
    .dukops-profile-area {
        width: 70px;
        padding: 4px;
    }
    
    .dukops-profile-img {
        height: 60px;
    }
    
    .dukops-profile-name {
        font-size: 9px;
    }
    
    .dukops-header-title {
        font-size: 14px;
    }
    
    .dukops-header-title:last-of-type {
        font-size: 12px;
    }
    
    .dukops-header-address {
        font-size: 9px;
    }
    
    .audio-control-wrapper {
        padding: 2px 8px;
    }
    
    .audio-volume-slider {
        width: 60px;
    }
    
    .counter-value {
        font-size: 14px;
        padding: 1px 10px;
    }
    
    .nav-buttons {
        flex-wrap: wrap;
        gap: 4px;
    }
    
    .nav-btn {
        font-size: 10px;
        padding: 8px 10px;
        flex: 1 1 30%;
    }
    
    .nav-btn i {
        font-size: 12px;
    }
    
    /* ================================================================
       TELEGRAM RESPONSIVE - DIHAPUS
       ================================================================ */
    
    .dukops-announcement-bar {
        font-size: 10px;
        padding: 6px 0;
    }
    
    .dukops-announcement-text {
        animation-duration: 15s;
    }
    
    .running-text-container {
        padding: 6px 12px;
    }
    
    .running-text {
        font-size: 11px;
        animation-duration: 10s;
    }
    
    .action-buttons {
        flex-direction: column;
    }
    
    .action-buttons button {
        width: 100%;
        min-width: auto;
        font-size: 12px;
    }
    
    .jadwal-section {
        padding: 12px;
    }
    
    .jadwal-section h3 {
        font-size: 13px;
    }
    
    .jadwal-title {
        font-size: 18px;
    }
    
    #j_hasilPesanBaru {
        font-size: 11px;
        min-height: 120px;
        padding: 10px;
    }
    
    .absen-stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 6px;
    }
    
    .absen-stat-value {
        font-size: 1.1rem;
    }
    
    .absen-desa-item {
        flex-wrap: wrap;
        gap: 6px;
        padding: 6px 8px;
    }
    
    .absen-desa-name {
        flex: 1 1 100%;
        font-size: 0.7rem;
    }
    
    .absen-desa-progress {
        min-width: 50px;
    }
    
    .absen-status-badge {
        font-size: 0.5rem;
        min-width: 50px;
        padding: 1px 6px;
    }
    
    .splash-title-center {
        font-size: 22px;
    }
    
    .splash-title-center:last-of-type {
        font-size: 16px;
    }
    
    .splash-logo-center img {
        width: 60px;
    }
    
    .splash-progress-center {
        width: 150px;
    }
    
    .modal-ai-content {
        width: 98%;
        height: 90vh;
        border-radius: 14px;
    }
    
    .modal-template-text {
        font-size: 0.7rem;
    }
    
    .modal-ai-header h3 {
        font-size: 1rem;
    }
    
    #categorySelect {
        font-size: 12px;
        padding: 8px 10px;
    }
    
    .thankyou-content {
        padding: 20px;
    }
    
    .thankyou-content .icon {
        font-size: 48px;
    }
    
    .thankyou-content h2 {
        font-size: 20px;
    }
    
    .thankyou-content p {
        font-size: 13px;
    }
    
    .led-letter {
        font-size: 16px;
        padding: 0 2px;
    }
    
    .led-running-text {
        animation-duration: 10s;
    }
    
    .knight-rider-text {
        font-size: 12px;
    }
    
    .knight-rider-container {
        padding: 6px 12px;
        border-radius: 20px;
    }
}

@media (max-width: 360px) {
    .dukops-profile-area {
        width: 60px;
    }
    
    .dukops-profile-img {
        height: 50px;
    }
    
    .dukops-header-title {
        font-size: 12px;
    }
    
    .dukops-header-title:last-of-type {
        font-size: 10px;
    }
    
    .dukops-header-address {
        font-size: 8px;
    }
    
    .counter-value {
        font-size: 12px;
        padding: 1px 8px;
    }
    
    .audio-control-btn {
        width: 26px;
        height: 26px;
        font-size: 11px;
    }
    
    .nav-btn {
        font-size: 9px;
        padding: 6px 6px;
        gap: 3px;
    }
    
    .nav-btn i {
        font-size: 10px;
    }
    
    .absen-btn {
        font-size: 10px;
        padding: 6px 10px;
    }
    
    .jadwal-title {
        font-size: 16px;
    }
} 
/* ===== End of responsive.css ===== */ 
 
 
/* ========================================== */ 
/*   File: slider-volume.css                                */ 
/* ========================================== */ 
/* ================================================================
   SLIDER-VOLUME.CSS - GARIS PANJANG + PUTIH
   ================================================================ */

/* ===== SLIDER - PANJANG MENGIKUTI ALAMAT ===== */
.audio-volume-slider {
    -webkit-appearance: none !important;
    appearance: none !important;
    width: 100% !important;           /* ← MENGIKUTI LEBAR */
    max-width: 380px !important;      /* ← SEPANJANG ALAMAT */
    height: 3px !important;
    background: rgba(255, 255, 255, 0.25) !important;
    border-radius: 3px !important;
    outline: none !important;
    cursor: pointer !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: inline-block !important;
    vertical-align: middle !important;
}

/* ===== TANPA WARNA KUNING ===== */
.audio-volume-slider {
    background: rgba(255, 255, 255, 0.25) !important;
}

/* ===== BULAT PUTIH KECIL ===== */
.audio-volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none !important;
    appearance: none !important;
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
    cursor: pointer !important;
    margin-top: -3.5px !important;
    border: none !important;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2) !important;
    transition: all 0.2s ease !important;
}

.audio-volume-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15) !important;
}

/* ===== FIREFOX ===== */
.audio-volume-slider::-moz-range-thumb {
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
    cursor: pointer !important;
    border: none !important;
}

.audio-volume-slider::-moz-range-track {
    height: 3px !important;
    background: rgba(255, 255, 255, 0.25) !important;
    border: none !important;
    border-radius: 3px !important;
}

/* ===== WRAPPER ===== */
.audio-control-wrapper {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-top: 4px !important;
    padding: 2px 0 !important;
    width: 100% !important;
    max-width: 380px !important;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 480px) {
    .audio-volume-slider {
        height: 2px !important;
        max-width: 280px !important;
    }
    
    .audio-volume-slider::-webkit-slider-thumb {
        width: 8px !important;
        height: 8px !important;
        margin-top: -3px !important;
    }
    
    .audio-volume-slider::-moz-range-thumb {
        width: 8px !important;
        height: 8px !important;
    }
    
    .audio-control-wrapper {
        max-width: 280px !important;
    }
}

@media (max-width: 360px) {
    .audio-volume-slider {
        max-width: 200px !important;
        height: 2px !important;
    }
    
    .audio-volume-slider::-webkit-slider-thumb {
        width: 6px !important;
        height: 6px !important;
        margin-top: -2px !important;
    }
    
    .audio-volume-slider::-moz-range-thumb {
        width: 6px !important;
        height: 6px !important;
    }
    
    .audio-control-wrapper {
        max-width: 200px !important;
    }
}
/* ===== End of slider-volume.css ===== */ 
/* ===== End of slider-volume.css ===== */ 
 
 
/* ========================================== */ 
/*   File: splash.css                                */ 
/* ========================================== */ 
/* ================================================================
   SPLASH.CSS - SPLASH SCREEN
   ================================================================ */

.splash-container-modern {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #050d1a 0%, #0a1a3a 40%, #0d2a4a 70%, #0a1a2a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.8s ease, transform 0.8s ease;
}

.splash-container-modern::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse at center, rgba(255, 215, 0, 0.03) 0%, transparent 70%);
    animation: splashGlow 6s ease-in-out infinite;
}

@keyframes splashGlow {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.2); opacity: 1; }
}

.splash-content {
    text-align: center;
    padding: 20px;
    max-width: 400px;
    position: relative;
    z-index: 1;
    animation: splashFadeUp 0.8s ease-out;
}

@keyframes splashFadeUp {
    from { opacity: 0; transform: translateY(40px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.splash-logo-center img {
    width: 90px;
    height: auto;
    filter: drop-shadow(0 0 30px rgba(255, 215, 0, 0.2));
    animation: splashPulse 2s ease-in-out infinite;
}

@keyframes splashPulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.05); opacity: 1; filter: drop-shadow(0 0 40px rgba(255, 215, 0, 0.3)); }
}

.splash-title-center {
    font-size: 34px;
    font-weight: 800;
    color: #FFD700;
    letter-spacing: 4px;
    margin: 5px 0;
    text-shadow: 0 0 30px rgba(255, 215, 0, 0.15);
}

.splash-title-center:last-of-type {
    font-size: 20px;
    color: #FFC107;
    letter-spacing: 2px;
}

.splash-divider-center {
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, transparent, #FFD700, transparent);
    margin: 10px auto;
    border-radius: 3px;
}

.splash-subtitle-center {
    font-size: 12px;
    color: #88aacc;
    letter-spacing: 2px;
    margin-top: 8px;
    text-transform: uppercase;
}

.splash-unit-center {
    font-size: 14px;
    color: #aaccee;
    font-weight: 500;
    margin-top: 12px;
    letter-spacing: 1px;
}

.splash-kodim-center {
    font-size: 11px;
    color: #6688aa;
    margin-top: 4px;
}

.splash-progress-center {
    width: 200px;
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    margin: 25px auto 10px;
    overflow: hidden;
    position: relative;
}

.splash-progress-bar-center {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #FFD700, #FFA500);
    border-radius: 4px;
    transition: width 0.3s ease;
    position: relative;
}

.splash-progress-bar-center::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: progressShine 1.5s infinite;
}

@keyframes progressShine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

.splash-percentage-center {
    font-size: 12px;
    color: #FFD700;
    font-weight: bold;
    letter-spacing: 1px;
} 
/* ===== End of splash.css ===== */ 
 
 
/* ========================================== */ 
/*   File: tab-absen.css                                */ 
/* ========================================== */ 
/* ================================================================
   TAB-ABSEN.CSS - TAB ABSENSI
   ================================================================ */

.absen-card {
    background: rgba(0, 40, 0, 0.2);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 16px;
    border: 1px solid rgba(76, 175, 80, 0.04);
    backdrop-filter: blur(4px);
}

.absen-card select {
    background: rgba(0, 0, 0, 0.2);
    border-color: rgba(76, 175, 80, 0.06);
    margin-top: 4px;
}

.absen-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 16px 0;
}

.absen-stat-card {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    padding: 12px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.02);
}

.absen-stat-value {
    font-size: 1.4rem;
    font-weight: 700;
}

.absen-stat-label {
    font-size: 0.65rem;
    color: #889988;
    margin-top: 2px;
}

.absen-progress-container {
    margin: 12px 0;
}

.absen-progress-bar {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    height: 6px;
    overflow: hidden;
}

.absen-progress-fill {
    background: linear-gradient(90deg, #4CAF50, #8bc34a);
    height: 100%;
    width: 0%;
    border-radius: 10px;
    transition: width 0.6s ease;
}

.absen-desa-list {
    max-height: none;
    overflow-y: visible;
}

.absen-desa-item {
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 6px;
    padding: 8px 10px;
}

.absen-desa-item:hover {
    background: rgba(255, 255, 255, 0.02);
}

.absen-desa-name {
    flex: 2;
    font-size: 0.8rem;
    font-weight: 500;
}

.absen-desa-stats {
    min-width: 45px;
    font-size: 0.7rem;
    text-align: center;
    color: #889988;
}

.absen-desa-progress {
    flex: 1;
    min-width: 60px;
}

.absen-desa-progress-bar {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 5px;
    height: 4px;
}

.absen-desa-progress-fill {
    height: 4px;
    border-radius: 5px;
    transition: width 0.6s ease;
}

.absen-status-badge {
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 0.55rem;
    font-weight: 600;
    min-width: 60px;
    text-align: center;
    letter-spacing: 0.5px;
}

.absen-status-lengkap {
    background: rgba(27, 94, 32, 0.3);
    color: #a5d6a7;
    border: 1px solid rgba(27, 94, 32, 0.1);
}

.absen-status-belum-lengkap {
    background: rgba(230, 81, 0, 0.2);
    color: #ffcc80;
    border: 1px solid rgba(230, 81, 0, 0.1);
}

.absen-status-belum {
    background: rgba(183, 28, 28, 0.2);
    color: #ef9a9a;
    border: 1px solid rgba(183, 28, 28, 0.1);
}

.absen-btn {
    background: rgba(255, 255, 255, 0.03);
    color: #ddeedd;
    border: 1px solid rgba(76, 175, 80, 0.06);
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    transition: all 0.3s ease;
    font-family: 'Segoe UI', Arial, sans-serif;
}

.absen-btn:hover {
    background: rgba(76, 175, 80, 0.05);
    border-color: rgba(76, 175, 80, 0.1);
}

.absen-btn-primary {
    background: linear-gradient(135deg, #1a4a7a, #2d6a9a);
    border-color: rgba(52, 152, 219, 0.1);
}

.absen-btn-primary:hover {
    background: linear-gradient(135deg, #2d6a9a, #3d8aba);
}

.button-row-absen {
    display: flex;
    gap: 10px;
    margin: 12px 0;
}

.button-row-absen button {
    flex: 1;
    margin: 0;
}

.absen-loading {
    text-align: center;
    padding: 30px;
    color: #4dff4d;
}

.absen-spinner {
    display: inline-block;
    width: 30px;
    height: 30px;
    border: 3px solid rgba(76, 175, 80, 0.05);
    border-top-color: #4CAF50;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

.absen-info-text {
    text-align: center;
    font-size: 0.6rem;
    margin-top: 12px;
    color: #889988;
    letter-spacing: 0.5px;
} 
/* ===== End of tab-absen.css ===== */ 
 
 
/* ========================================== */ 
/*   File: thankyou-popup.css                                */ 
/* ========================================== */ 
/* ================================================================
   THANKYOU-POPUP.CSS - POPUP TERIMA KASIH
   ================================================================ */

.thankyou-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    animation: fadeIn 0.5s ease;
}

.thankyou-content {
    background: linear-gradient(135deg, #1a2a1a, #2b4d2b);
    padding: 40px;
    border-radius: 20px;
    max-width: 400px;
    width: 90%;
    text-align: center;
    border: 2px solid #4CAF50;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    animation: scaleIn 0.5s ease;
}

.thankyou-content .fa-trophy {
    animation: pulse 2s infinite;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes scaleIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 480px) {
    .thankyou-content {
        padding: 24px;
        width: 92%;
    }
}
/* ===== End of thankyou-popup.css ===== */ 
/* ===== End of thankyou-popup.css ===== */ 
 
 
