/* ========================================== */ 
/*   File: navigation.css                                */ 
/* ========================================== */ 
/* ================================================================
   NAVIGATION.CSS - NAVIGASI KAPSUL 3D REALISTIS PREMIUM
   ================================================================ */

.nav-buttons {
    display: flex;
    flex-direction: row;
    gap: 12px;
    margin-bottom: 24px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 60px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    width: 100%;
    max-width: 900px;
}

/* ================================================================
   TOMBOL NAVIGASI - KAPSUL 3D DENGAN SEMUA EFEK PREMIUM
   ================================================================ */
.nav-btn {
    flex: 1;
    padding: 16px 28px;
    border: none;
    border-radius: 60px;
    cursor: pointer;
    font-weight: 700;
    font-size: 17px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    letter-spacing: 0.5px;
    
    /* Transisi smooth dengan efek spring premium */
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    
    /* Default: transparan dengan teks */
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    
    /* Posisi relatif untuk pseudo-elements */
    position: relative;
    
    /* Teks shadow untuk keterbacaan */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    
    /* Mencegah overflow pseudo-elements */
    overflow: hidden;
    
    /* Memastikan semua tombol sama panjang */
    min-width: 0;
    white-space: nowrap;
    flex: 1 1 0;
}

/* ================================================================
   EFEK KILAP/KILAU PREMIUM DI ATAS TOMBOL
   ================================================================ */
.nav-btn::before {
    content: '';
    position: absolute;
    top: 8%;
    left: 15%;
    right: 15%;
    height: 30%;
    border-radius: 60px;
    background: radial-gradient(
        ellipse at center,
        rgba(255, 255, 255, 0.4) 0%,
        rgba(255, 255, 255, 0.08) 50%,
        transparent 80%
    );
    pointer-events: none;
    opacity: 0;
    transition: all 0.4s ease;
    z-index: 1;
}

/* ================================================================
   EFEK BAYANGAN DALAM PREMIUM DI BAWAH TOMBOL
   ================================================================ */
.nav-btn::after {
    content: '';
    position: absolute;
    bottom: 5%;
    left: 20%;
    right: 20%;
    height: 15%;
    border-radius: 60px;
    background: radial-gradient(
        ellipse at center,
        rgba(0, 0, 0, 0.25) 0%,
        transparent 70%
    );
    pointer-events: none;
    opacity: 0;
    transition: all 0.4s ease;
    z-index: 1;
}

/* ================================================================
   HOVER PREMIUM - EFEK MENGAMBANG DENGAN KILAP
   ================================================================ */
.nav-btn:hover {
    transform: translateY(-4px) scale(1.03);
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    
    /* Bayangan 3D premium saat hover */
    box-shadow: 
        0 16px 40px -10px rgba(0, 0, 0, 0.5),
        0 5px 0 rgba(255, 165, 0, 0.25),
        0 8px 0 rgba(255, 165, 0, 0.1),
        inset 0 -5px 10px rgba(0, 0, 0, 0.1),
        inset 0 5px 16px rgba(255, 255, 255, 0.2);
}

.nav-btn:hover::before {
    opacity: 1;
    top: 5%;
    left: 10%;
    right: 10%;
    height: 38%;
    background: radial-gradient(
        ellipse at center,
        rgba(255, 255, 255, 0.6) 0%,
        rgba(255, 255, 255, 0.15) 50%,
        transparent 80%
    );
}

.nav-btn:hover::after {
    opacity: 1;
}

/* ================================================================
   ICON PREMIUM DENGAN EFEK
   ================================================================ */
.nav-btn i {
    font-size: 24px;
    font-weight: bold;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    flex-shrink: 0;
}

.nav-btn:hover i {
    transform: translateY(-4px) scale(1.15) rotate(-3deg);
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
}

/* ================================================================
   ACTIVE STATE PREMIUM - KAPSUL 3D REALISTIS
   ================================================================ */
.nav-btn.active {
    color: #ffffff;
    transform: translateY(0) scale(1);
    
    /* Bayangan 3D premium multi-layer */
    box-shadow: 
        /* Bayangan ambient jatuh kebawah */
        0 24px 48px -12px rgba(0, 0, 0, 0.6),
        /* Ketebalan tombol layer 1 */
        0 7px 0 rgba(0, 0, 0, 0.25),
        /* Ketebalan tombol layer 2 */
        0 10px 0 rgba(0, 0, 0, 0.12),
        /* Bayangan dalam atas (cahaya) */
        inset 0 8px 16px rgba(255, 255, 255, 0.35),
        /* Bayangan dalam bawah (volume) */
        inset 0 -8px 16px rgba(0, 0, 0, 0.3);
    
    /* Animasi bounce premium */
    animation: capsuleActivePremium 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Kilap premium pada tombol aktif */
.nav-btn.active::before {
    opacity: 1;
    top: 6%;
    left: 10%;
    right: 10%;
    height: 35%;
    background: radial-gradient(
        ellipse at center,
        rgba(255, 255, 255, 0.6) 0%,
        rgba(255, 255, 255, 0.15) 50%,
        transparent 80%
    );
}

.nav-btn.active::after {
    opacity: 0.7;
}

/* ================================================================
   VARIASI WARNA PREMIUM PER TOMBOL (ACTIVE)
   ================================================================ */

/* Tombol Dukops - Gradien Oranye ke Emas Premium */
.nav-btn-dukops.active {
    background: linear-gradient(145deg, #f7971e, #e07c00);
    box-shadow: 
        0 24px 48px -12px rgba(247, 151, 30, 0.5),
        0 7px 0 #a85f00,
        0 10px 0 #8a4d00,
        inset 0 8px 16px rgba(255, 255, 255, 0.35),
        inset 0 -8px 16px rgba(0, 0, 0, 0.3);
}

/* Tombol Piket - Gradien Hijau ke Emerald Premium */
.nav-btn-piket.active {
    background: linear-gradient(145deg, #1db954, #158a3a);
    box-shadow: 
        0 24px 48px -12px rgba(29, 185, 84, 0.5),
        0 7px 0 #0f6b2d,
        0 10px 0 #0c5523,
        inset 0 8px 16px rgba(255, 255, 255, 0.35),
        inset 0 -8px 16px rgba(0, 0, 0, 0.3);
}

/* Tombol Absen - Gradien Biru ke Electric Premium */
.nav-btn-absen.active {
    background: linear-gradient(145deg, #4facfe, #0066cc);
    box-shadow: 
        0 24px 48px -12px rgba(79, 172, 254, 0.5),
        0 7px 0 #004d99,
        0 10px 0 #003d7a,
        inset 0 8px 16px rgba(255, 255, 255, 0.35),
        inset 0 -8px 16px rgba(0, 0, 0, 0.3);
}

/* ================================================================
   EFEK PRESSED PREMIUM (SAAT DIKLIK)
   ================================================================ */
.nav-btn:active {
    transform: translateY(5px) scale(0.96);
    
    box-shadow: 
        0 10px 24px -8px rgba(0, 0, 0, 0.5),
        0 4px 0 rgba(0, 0, 0, 0.2),
        0 6px 0 rgba(0, 0, 0, 0.1),
        inset 0 -5px 10px rgba(0, 0, 0, 0.35),
        inset 0 5px 10px rgba(255, 255, 255, 0.15);
    
    transition-duration: 0.08s;
}

.nav-btn:active i {
    transform: scale(0.85) rotate(0deg);
}

.nav-btn:active::before {
    opacity: 0.5;
    top: 10%;
    height: 25%;
}

/* ================================================================
   ANIMASI ACTIVE PREMIUM
   ================================================================ */
@keyframes capsuleActivePremium {
    0% {
        transform: scale(0.90) translateY(5px);
    }
    35% {
        transform: scale(1.06) translateY(-3px);
    }
    65% {
        transform: scale(0.97) translateY(2px);
    }
    100% {
        transform: scale(1) translateY(0);
    }
}

/* ================================================================
   ANIMASI BREATHE (OPSIONAL - UNTUK TOMBOL AKTIF)
   ================================================================ */
.nav-btn.breathe {
    animation: breathe 3s ease-in-out infinite;
}

@keyframes breathe {
    0%, 100% {
        box-shadow: 
            0 24px 48px -12px rgba(0, 0, 0, 0.6),
            0 7px 0 rgba(0, 0, 0, 0.25),
            0 10px 0 rgba(0, 0, 0, 0.12),
            inset 0 8px 16px rgba(255, 255, 255, 0.35),
            inset 0 -8px 16px rgba(0, 0, 0, 0.3);
    }
    50% {
        box-shadow: 
            0 28px 56px -14px rgba(0, 0, 0, 0.7),
            0 7px 0 rgba(0, 0, 0, 0.3),
            0 10px 0 rgba(0, 0, 0, 0.15),
            inset 0 8px 20px rgba(255, 255, 255, 0.45),
            inset 0 -8px 16px rgba(0, 0, 0, 0.35);
        transform: scale(1.02);
    }
}

/* ================================================================
   RESPONSIVE - TETAP HORIZONTAL DENGAN UKURAN SAMA
   ================================================================ */
@media (max-width: 768px) {
    .nav-buttons {
        flex-direction: row;
        flex-wrap: wrap;
        border-radius: 40px;
        gap: 8px;
        padding: 8px;
        max-width: 100%;
    }
    
    .nav-btn {
        padding: 14px 18px;
        font-size: 15px;
        border-radius: 40px;
        flex: 1 1 0;
        min-width: 80px;
        gap: 8px;
    }
    
    .nav-btn i {
        font-size: 20px;
    }
    
    .nav-btn.active {
        border-radius: 40px;
        box-shadow: 
            0 20px 40px -10px rgba(0, 0, 0, 0.5),
            0 6px 0 rgba(0, 0, 0, 0.2),
            0 8px 0 rgba(0, 0, 0, 0.1),
            inset 0 6px 12px rgba(255, 255, 255, 0.3),
            inset 0 -6px 12px rgba(0, 0, 0, 0.25);
    }
    
    .nav-btn::before,
    .nav-btn::after {
        border-radius: 40px;
    }
    
    .nav-btn-dukops.active,
    .nav-btn-piket.active,
    .nav-btn-absen.active {
        box-shadow: 
            0 20px 40px -10px rgba(0, 0, 0, 0.5),
            0 6px 0 rgba(0, 0, 0, 0.2),
            0 8px 0 rgba(0, 0, 0, 0.1),
            inset 0 6px 12px rgba(255, 255, 255, 0.3),
            inset 0 -6px 12px rgba(0, 0, 0, 0.25);
    }
}

@media (max-width: 480px) {
    .nav-buttons {
        gap: 6px;
        padding: 6px;
        border-radius: 28px;
    }
    
    .nav-btn {
        padding: 11px 12px;
        font-size: 12px;
        gap: 5px;
        border-radius: 28px;
        min-width: 55px;
        flex: 1 1 0;
    }
    
    .nav-btn i {
        font-size: 16px;
    }
    
    .nav-btn.active {
        border-radius: 28px;
        box-shadow: 
            0 16px 32px -8px rgba(0, 0, 0, 0.4),
            0 4px 0 rgba(0, 0, 0, 0.2),
            0 6px 0 rgba(0, 0, 0, 0.1),
            inset 0 4px 8px rgba(255, 255, 255, 0.25),
            inset 0 -4px 8px rgba(0, 0, 0, 0.2);
    }
    
    .nav-btn::before,
    .nav-btn::after {
        border-radius: 28px;
    }
    
    .nav-btn-dukops.active,
    .nav-btn-piket.active,
    .nav-btn-absen.active {
        box-shadow: 
            0 16px 32px -8px rgba(0, 0, 0, 0.4),
            0 4px 0 rgba(0, 0, 0, 0.2),
            0 6px 0 rgba(0, 0, 0, 0.1),
            inset 0 4px 8px rgba(255, 255, 255, 0.25),
            inset 0 -4px 8px rgba(0, 0, 0, 0.2);
    }
}

/* ================================================================
   PENYESUAIAN UNTUK TOMBOL DENGAN TEKS PANJANG
   ================================================================ */
.nav-btn-long {
    font-size: 15px;
    padding: 16px 20px;
}

@media (max-width: 768px) {
    .nav-btn-long {
        font-size: 13px;
        padding: 14px 14px;
    }
}

@media (max-width: 480px) {
    .nav-btn-long {
        font-size: 11px;
        padding: 11px 10px;
    }
} 
/* ===== End of navigation.css ===== */ 
 
 
/* ========================================== */ 
/*   File: notification.css                                */ 
/* ========================================== */ 
/* ================================================================
   NOTIFICATION.CSS - NOTIFIKASI
   ================================================================ */

.notification {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    padding: 14px 24px;
    border-radius: 14px;
    z-index: 1000;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    max-width: 90%;
    min-width: 280px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
    animation: notifSlideUp 0.4s ease-out;
}

@keyframes notifSlideUp {
    from { opacity: 0; transform: translateX(-50%) translateY(20px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

.notification.success {
    background: rgba(46, 125, 50, 0.9);
    color: #a5d6a7;
    border-color: rgba(76, 175, 80, 0.2);
}

.notification.error {
    background: rgba(183, 28, 28, 0.9);
    color: #ef9a9a;
    border-color: rgba(244, 67, 54, 0.2);
}

.notification.warning {
    background: rgba(230, 81, 0, 0.9);
    color: #ffcc80;
    border-color: rgba(255, 152, 0, 0.2);
}

.jadwal-toast {
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    color: white;
    padding: 14px 24px;
    border-radius: 30px;
    z-index: 10000;
    opacity: 0;
    transition: all 0.4s ease;
    max-width: 90%;
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.jadwal-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
} 
/* ===== End of notification.css ===== */ 
 
 
/* ========================================== */ 
/*   File: popup.css                                */ 
/* ========================================== */ 
/* ================================================================
   POPUP.CSS - MODAL AI & THANK YOU
   ================================================================ */

/* ============ AI TEMPLATE MODAL ============ */
.modal-ai {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
}

.modal-ai.show {
    display: flex !important;
}

.modal-ai-content {
    background: linear-gradient(145deg, #1a2a1f, #0f1a12);
    margin: 0 auto;
    padding: 0;
    width: 95%;
    max-width: 680px;
    height: 80vh;
    max-height: 580px;
    border-radius: 20px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(46, 204, 113, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: modalSlideIn 0.3s ease;
}

@keyframes modalSlideIn {
    from { opacity: 0; transform: translateY(-30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-ai-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: linear-gradient(135deg, #0d2a1d, #0a1f15);
    border-bottom: 1px solid #2e8b57;
    flex-shrink: 0;
}

.modal-ai-header h3 {
    margin: 0;
    color: #9fd49f;
    font-size: 1.15rem;
    font-weight: 600;
}

.modal-ai-header h3 i {
    margin-right: 8px;
    color: #2ecc71;
}

.modal-close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #9fd49f;
    transition: all 0.2s;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

.modal-close:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ff6b6b;
    transform: rotate(90deg);
}

.modal-ai-tabs {
    padding: 12px 16px;
    background: #0e1712;
    border-bottom: 1px solid #1e3a2a;
    flex-shrink: 0;
}

#categorySelect {
    width: 100%;
    padding: 10px 14px;
    border-radius: 12px;
    background: #1a2a1f;
    color: #e6ffe6;
    border: 1px solid rgba(46, 204, 113, 0.2);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Segoe UI', Arial, sans-serif;
}

#categorySelect:hover {
    border-color: #2ecc71;
    background: #2a3a2a;
}

#categorySelect:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.1);
}

.modal-ai-body {
    padding: 16px;
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
    scrollbar-color: #2ecc71 #1a2a1f;
}

.modal-ai-body::-webkit-scrollbar {
    width: 5px;
}

.modal-ai-body::-webkit-scrollbar-track {
    background: #1a2a1f;
    border-radius: 10px;
}

.modal-ai-body::-webkit-scrollbar-thumb {
    background: #2ecc71;
    border-radius: 10px;
}

.modal-template-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.modal-template-item {
    background: #0f1a12;
    border-radius: 12px;
    padding: 12px 16px;
    cursor: pointer;
    transition: all 0.25s ease;
    border: 1px solid #2a4a2a;
}

.modal-template-item:hover {
    background: #1a2a1f;
    border-color: #2ecc71;
    transform: translateX(4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.modal-template-item:active {
    transform: scale(0.98);
}

.modal-template-text {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #c8e6d0;
}

.loading-templates {
    text-align: center;
    padding: 40px;
    color: #9fd49f;
    font-size: 0.9rem;
}

.loading-templates i {
    margin-right: 8px;
}

/* ================= THANK YOU POPUP ================= */
.thankyou-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    animation: popupFade 0.4s ease-out;
}

@keyframes popupFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

.thankyou-content {
    background: linear-gradient(145deg, #0d1a0d, #1a3a1a);
    padding: 32px 36px;
    border-radius: 20px;
    max-width: 90%;
    width: 440px;
    text-align: center;
    border: 1px solid rgba(255, 215, 0, 0.06);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    animation: popupScale 0.4s ease-out;
}

@keyframes popupScale {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

.thankyou-content .icon {
    font-size: 56px;
    color: #FFD700;
    margin-bottom: 12px;
    display: block;
}

.thankyou-content h2 {
    color: #FFD700;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
}

.thankyou-content p {
    color: #b2d8b2;
    font-size: 14px;
    line-height: 1.7;
}

.thankyou-content .highlight {
    background: rgba(255, 215, 0, 0.04);
    border: 1px solid rgba(255, 215, 0, 0.06);
    border-radius: 12px;
    padding: 12px;
    margin: 14px 0;
    color: #FFD700;
    font-weight: 600;
    font-size: 13px;
}

.thankyou-content .sub {
    color: #889988;
    font-size: 12px;
    margin-bottom: 16px;
}

.thankyou-content button {
    background: linear-gradient(135deg, #1a4a1a, #2d6a2d);
    border: 1px solid rgba(76, 175, 80, 0.1);
    border-radius: 12px;
    padding: 12px 24px;
    color: #fff;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    font-family: 'Segoe UI', Arial, sans-serif;
}

.thankyou-content button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.15);
} 
/* ===== End of popup.css ===== */ 
 
 
/* ========================================== */ 
/*   File: preview-fixes.css                                */ 
/* ========================================== */ 
/* ================================================================
   PREVIEW-FIXES.CSS - PERBAIKAN PREVIEW
   ================================================================ */

/* ===== HILANGKAN PREVIEW DESA ===== */
#previewDesa {
    display: none !important;
}

/* ===== PERBAIKAN PREVIEW KOORDINAT ===== */
#previewKordinat {
    color: #0a1a2e !important;
    font-weight: 500 !important;
    min-height: 30px !important;
}

#previewGambar {
    color: #0a1a2e !important;
    font-weight: 500 !important;
}

#previewTanggal {
    color: #0a1a2e !important;
    font-weight: 500 !important;
}

/* ===== LOADING KOORDINAT ===== */
#loadingKoordinat {
    color: #0a1a2e !important;
    font-weight: 500 !important;
}

/* ===== PREVIEW BOX ===== */
.previewBox {
    color: #0a1a2e !important;
    font-weight: 500 !important;
    border: 2px solid #2a5a8a !important;
    background: #f5f9ff !important;
    border-radius: 14px !important;
    padding: 18px 20px !important;
    margin: 6px 0 14px 0 !important;
    font-size: 1.1rem !important;
}

.previewBox * {
    color: #0a1a2e !important;
}

/* ===== NARASI TEXTAREA ===== */
#narasi {
    min-height: 350px !important;
    height: auto !important;
    max-height: 500px !important;
    resize: vertical !important;
    padding: 18px !important;
    font-size: 1.15rem !important;
    line-height: 1.9 !important;
    color: #0a1a2e !important;
    background: #ffffff !important;
    font-weight: 500 !important;
    border: 2px solid #2a5a8a !important;
    border-radius: 12px !important;
}

/* ===== SELECT, INPUT, TEXTAREA ===== */
select, input, textarea {
    color: #0a1a2e !important;
    background: #ffffff !important;
    font-weight: 500 !important;
    border: 2px solid #2a5a8a !important;
}

select option {
    color: #0a1a2e !important;
    background: #ffffff !important;
    font-weight: 500 !important;
}

::placeholder {
    color: #6a7a8a !important;
    font-weight: 400 !important;
    opacity: 1 !important;
}

select:focus, input:focus, textarea:focus {
    border-color: #1a5a9a !important;
    box-shadow: 0 0 0 4px rgba(26, 90, 154, 0.2) !important;
    outline: none !important;
}

select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230a1a2e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 18px;
    padding-right: 40px !important;
}
/* ===== End of preview-fixes.css ===== */ 
/* ===== End of preview-fixes.css ===== */ 
 
 
/* ========================================== */ 
/*   File: responsive.css                                */ 
