/* ========================================== */ 
/*   File: action-buttons.css                                */ 
/* ========================================== */ 
/* ================================================================
   ACTION-BUTTONS.CSS - TOMBOL AKSI
   ================================================================ */

.action-buttons {
    display: flex;
    gap: 10px;
    margin-top: 10px;
    flex-wrap: wrap;
}

.action-buttons button {
    flex: 1;
    min-width: 120px;
}

#submitBtn {
    background: #1a6a3a !important;
    color: #ffffff !important;
}

#resetBtn {
    background: #e8ecf0 !important;
    color: #1a2a3a !important;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 480px) {
    .action-buttons {
        flex-direction: column;
    }
    
    .action-buttons button {
        width: 100%;
        min-width: auto;
    }
}
/* ===== End of action-buttons.css ===== */ 
/* ===== End of action-buttons.css ===== */ 
 
 
/* ========================================== */ 
/*   File: ai-template.css                                */ 
/* ========================================== */ 
/* ================================================================
   AI-TEMPLATE.CSS - TEMPLATE AI
   ================================================================ */

.ai-template-container {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0;
    flex-wrap: wrap;
}

.ai-template-btn {
    background: rgba(255, 255, 255, 0.76);
    color: #0e0101 !important;
    border: none !important;
    padding: 10px 18px !important;
    border-radius: 10px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.ai-template-btn:hover {
    background: rgba(135, 16, 16, 0.589);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

.ai-template-btn i {
    font-size: 16px;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 480px) {
    .ai-template-container {
        flex-direction: column;
        align-items: stretch;
    }
    
    .ai-template-btn {
        justify-content: center;
    }
}
/* ===== End of ai-template.css ===== */ 
/* ===== End of ai-template.css ===== */ 
 
 
/* ========================================== */ 
/*   File: announcement.css                                */ 
/* ========================================== */ 
/* ================================================================
   ANNOUNCEMENT.CSS - ANNOUNCEMENT BAR
   ================================================================ */

.dukops-announcement-bar {
    width: 100%;
    background: #1a2a4a !important;
    padding: 10px 0 !important;
    border-bottom: 1px solid rgba(255, 215, 0, 0.04);
    overflow: hidden;
    white-space: nowrap;
}

.dukops-announcement-text {
    display: inline-block;
    padding-left: 100%;
    animation: dukops-running-text 25s linear infinite;
    font-size: 1rem !important;
    color: #ffdd77 !important;
    font-weight: 600;
    letter-spacing: 0.5px;
}

@keyframes dukops-running-text {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
}

.dukops-announcement-bar:hover .dukops-announcement-text {
    animation-play-state: paused;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 480px) {
    .dukops-announcement-text {
        font-size: 0.75rem !important;
        animation-duration: 15s;
    }
}
/* ===== End of announcement.css ===== */ 
/* ===== End of announcement.css ===== */ 
 
 
/* ========================================== */ 
/*   File: attendance.css                                */ 
/* ========================================== */ 
/* ================================================================
   ATTENDANCE.CSS - ABSENSI
   ================================================================ */

#attendancePanel {
    margin-top: 20px;
    background: rgba(0, 0, 0, 0.2);
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

.attendance-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.attendance-header button {
    margin: 0;
    padding: 8px 16px;
    background: rgba(255, 50, 50, 0.08);
    border: 1px solid rgba(255, 50, 50, 0.1);
    border-radius: 8px;
    color: #ff6b6b;
    font-size: 12px;
    width: auto;
    cursor: pointer;
    transition: all 0.3s ease;
}

.attendance-header button:hover {
    background: rgba(255, 50, 50, 0.15);
}

.attendance-filters {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
}

.attendance-filters select,
.attendance-filters input {
    flex: 1;
    min-width: 120px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.04);
    background: rgba(0, 0, 0, 0.2);
    color: #ddeedd;
    font-size: 12px;
}

.attendance-summary {
    background: rgba(255, 255, 255, 0.02);
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 16px;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 13px;
}

.summary-row span:last-child {
    font-weight: 600;
    color: #FFD700;
}

.progress-container {
    background: rgba(255, 255, 255, 0.04);
    height: 6px;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 10px;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #4CAF50, #8bc34a);
    transition: width 0.6s ease;
    border-radius: 10px;
}

.desa-card {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    margin-bottom: 10px;
    overflow: hidden;
    border-left: 3px solid #4CAF50;
    transition: all 0.3s ease;
}

.desa-card:hover {
    background: rgba(255, 255, 255, 0.04);
}

.desa-card.incomplete {
    border-left-color: #FF9800;
}

.desa-header {
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}

.desa-name {
    font-weight: 600;
    color: #b2d8b2;
    font-size: 14px;
}

.desa-count {
    background: rgba(255, 255, 255, 0.04);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    color: #889988;
}

.desa-files {
    padding: 8px 14px 14px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.02);
}

.file-link {
    color: #4CAF50;
    text-decoration: none;
    font-size: 12px;
    display: inline-block;
    padding: 2px 10px;
    border-radius: 4px;
    transition: all 0.3s ease;
}

.file-link:hover {
    background: rgba(76, 175, 80, 0.05);
} 
/* ===== End of attendance.css ===== */ 
 
 
/* ========================================== */ 
/*   File: base.css                                */ 
/* ========================================== */ 
/* ================================================================
   BASE.CSS - RESET & BASE
   ================================================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #0a1a3a;
    --secondary: #1a3a6a;
    --accent: #FFD700;
    --success: #4CAF50;
    --bg-dark: #000300f1;
    --bg-card: #162016;
    --text-light: #e6ffe6;
    --text-muted: #889988;
    --border-glow: rgba(238, 8, 219, 0.3);
}

body {
    font-family: 'Segoe UI', 'Arial', sans-serif;
    background: var(--bg-dark);
    color: var(--text-light);
    line-height: 1.6;
    min-height: 100vh;
    background-image: 
        radial-gradient(ellipse at 10% 20%, rgba(26, 58, 106, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 90% 80%, rgba(26, 58, 106, 0.10) 0%, transparent 50%);
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: #0a120a; }
::-webkit-scrollbar-thumb { background: #2ecc71; border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #4CAF50; } 
/* ===== End of base.css ===== */ 
 
 
/* ========================================== */ 
/*   File: buttons.css                                */ 
/* ========================================== */ 
/* ================================================================
   BUTTONS.CSS - TOMBOL
   ================================================================ */

button {
    margin-top: 16px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #1a4a1a, #2d6a2d);
    color: white;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    width: 100%;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 0.5px;
    border: 1px solid rgba(76, 175, 80, 0.1);
}

button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.15);
    background: linear-gradient(135deg, #2d6a2d, #3d8a3d);
}

button:disabled {
    background: #333;
    cursor: not-allowed;
    opacity: 0.4;
    transform: none !important;
    box-shadow: none !important;
}

button i {
    margin-right: 8px;
}

.action-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
}

.action-buttons button {
    width: auto;
    flex: 1;
    min-width: 120px;
    padding: 10px 16px;
    font-size: 13px;
}

.action-buttons button:first-child {
    background: linear-gradient(135deg, #1a4a1a, #2d6a2d);
    border-color: rgba(76, 175, 80, 0.2);
}

.action-buttons button:last-child {
    background: rgba(255, 50, 50, 0.08);
    border: 1px solid rgba(255, 50, 50, 0.15);
    color: #ff6b6b;
}

.action-buttons button:last-child:hover {
    background: rgba(255, 50, 50, 0.15);
    box-shadow: 0 8px 30px rgba(255, 50, 50, 0.1);
}

#installButton {
    position: fixed;
    bottom: 80px;
    right: 20px;
    background: linear-gradient(135deg, #4CAF50, #2d6a2d);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 12px 20px;
    font-weight: 600;
    cursor: pointer;
    z-index: 1000;
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.2);
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

#installButton:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 12px 40px rgba(76, 175, 80, 0.3);
} 
/* ===== End of buttons.css ===== */ 
 
 
