/*   File: main.css                                */ 
/* ========================================== */ 
/* ================================================================
   MAIN.CSS - IMPORT SEMUA FILE CSS
   ================================================================ */

@import url('base.css');
@import url('splash.css');
@import url('header.css');
@import url('navigation.css');
@import url('form.css');
@import url('buttons.css');
@import url('notification.css');
@import url('jadwal.css');
@import url('attendance.css');
@import url('tab-absen.css');
@import url('popup.css');
@import url('led-effects.css');
@import url('responsive.css'); 
/* ===== End of main.css ===== */ 
 
 
/* ========================================== */ 
/*   File: modal.css                                */ 
/* ========================================== */ 
/* ============ MODAL PILIH DESA ============ */
.modal-pilih-desa {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10001;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
}

.modal-pilih-desa.active {
    opacity: 1;
    visibility: visible;
}

.modal-desa-card {
    background: linear-gradient(145deg, #1a2a3a, #0f1a24);
    width: 90%;
    max-width: 400px;
    border-radius: 32px;
    padding: 32px 28px;
    text-align: center;
    box-shadow: 0 30px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,215,0,0.2);
    animation: modalPop 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
}

@keyframes modalPop {
    from { opacity: 0; transform: scale(0.9) translateY(-20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-desa-card h2 {
    font-size: 26px;
    margin-bottom: 8px;
    color: #FFD700;
}

.modal-desa-card p {
    color: #B0C4DE;
    margin-bottom: 24px;
    font-size: 13px;
}

.modal-desa-card select {
    width: 100%;
    padding: 14px 18px;
    font-size: 16px;
    border: 1.5px solid #FFD700;
    border-radius: 60px;
    background: #0a1a2a;
    color: #FFFFFF;
    cursor: pointer;
    outline: none;
    margin-bottom: 20px;
}

.modal-desa-card select option {
    background: #1a2a3a;
    color: #FFFFFF;
}

.btn-masuk {
    background: linear-gradient(135deg, #FFD700, #FFA500);
    color: #0a1a3a;
    border: none;
    width: 100%;
    padding: 14px;
    border-radius: 60px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}

.btn-masuk:active {
    transform: scale(0.97);
}

.btn-masuk:hover {
    box-shadow: 0 4px 15px rgba(255,215,0,0.3);
} 
/* ===== End of modal.css ===== */ 
 
 
/* ========================================== */ 
/*   File: navigation.css                                */ 
/* ========================================== */ 
/* ================================================================
   NAVIGATION.CSS - NAVIGASI
   ================================================================ */

.nav-buttons {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    padding: 4px;
    background: none;
    border-radius: 14px;
    border: none;
}

.nav-btn : .nav-btn.active{
    flex: 1;
    padding: 12px 16px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    font-size: 18px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: transparent;
    color: #e2af07f1;
}

.nav-btn i {
    font-size: bold 26px;
    transition: transform 0.3s ease;
}

.nav-btn:hover {
    color: #04094b;
    background: rgb(242, 237, 237);
}

.nav-btn:hover i {
    transform: translateY(-2px);
}

.nav-btn.active {
    color: #fff;
}

.nav-btn-dukops.active {
    background: linear-gradient(135deg, #11a409, hsl(22, 93%, 49%));
    box-shadow: 0 4px 20px rgba(255, 165, 0, 0.2);
}

.nav-btn-piket.active {
    background: linear-gradient(135deg, #11a409, hsl(22, 93%, 49%));
    box-shadow: 0 4px 20px rgba(255, 165, 0, 0.2);
}

.nav-btn-absen.active {
    background: linear-gradient(135deg, #11a409, hsl(22, 93%, 49%));
    box-shadow: 0 4px 20px rgba(255, 165, 0, 0.2);
} 
/* ===== End of navigation.css ===== */ 
 
 
/* ========================================== */ 
/*   File: notification.css                                */ 
/* ========================================== */ 
/* ================================================================
   NOTIFICATION.CSS - NOTIFIKASI
   ================================================================ */

.notification {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    padding: 14px 24px;
    border-radius: 14px;
    z-index: 1000;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    max-width: 90%;
    min-width: 280px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
    animation: notifSlideUp 0.4s ease-out;
}

@keyframes notifSlideUp {
    from { opacity: 0; transform: translateX(-50%) translateY(20px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

.notification.success {
    background: rgba(46, 125, 50, 0.9);
    color: #a5d6a7;
    border-color: rgba(76, 175, 80, 0.2);
}

.notification.error {
    background: rgba(183, 28, 28, 0.9);
    color: #ef9a9a;
    border-color: rgba(244, 67, 54, 0.2);
}

.notification.warning {
    background: rgba(230, 81, 0, 0.9);
    color: #ffcc80;
    border-color: rgba(255, 152, 0, 0.2);
}

.jadwal-toast {
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    color: white;
    padding: 14px 24px;
    border-radius: 30px;
    z-index: 10000;
    opacity: 0;
    transition: all 0.4s ease;
    max-width: 90%;
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.jadwal-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
} 
/* ===== End of notification.css ===== */ 
 
 
/* ========================================== */ 
/*   File: popup.css                                */ 
/* ========================================== */ 
/* ================================================================
   POPUP.CSS - MODAL AI & THANK YOU
   ================================================================ */

/* ============ AI TEMPLATE MODAL ============ */
.modal-ai {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
}

.modal-ai.show {
    display: flex !important;
}

.modal-ai-content {
    background: linear-gradient(145deg, #1a2a1f, #0f1a12);
    margin: 0 auto;
    padding: 0;
    width: 95%;
    max-width: 680px;
    height: 80vh;
    max-height: 580px;
    border-radius: 20px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(46, 204, 113, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: modalSlideIn 0.3s ease;
}

@keyframes modalSlideIn {
    from { opacity: 0; transform: translateY(-30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-ai-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: linear-gradient(135deg, #0d2a1d, #0a1f15);
    border-bottom: 1px solid #2e8b57;
    flex-shrink: 0;
}

.modal-ai-header h3 {
    margin: 0;
    color: #9fd49f;
    font-size: 1.15rem;
    font-weight: 600;
}

.modal-ai-header h3 i {
    margin-right: 8px;
    color: #2ecc71;
}

.modal-close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #9fd49f;
    transition: all 0.2s;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

.modal-close:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ff6b6b;
    transform: rotate(90deg);
}

.modal-ai-tabs {
    padding: 12px 16px;
    background: #0e1712;
    border-bottom: 1px solid #1e3a2a;
    flex-shrink: 0;
}

#categorySelect {
    width: 100%;
    padding: 10px 14px;
    border-radius: 12px;
    background: #1a2a1f;
    color: #e6ffe6;
    border: 1px solid rgba(46, 204, 113, 0.2);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Segoe UI', Arial, sans-serif;
}

#categorySelect:hover {
    border-color: #2ecc71;
    background: #2a3a2a;
}

#categorySelect:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.1);
}

.modal-ai-body {
    padding: 16px;
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
    scrollbar-color: #2ecc71 #1a2a1f;
}

.modal-ai-body::-webkit-scrollbar {
    width: 5px;
}

.modal-ai-body::-webkit-scrollbar-track {
    background: #1a2a1f;
    border-radius: 10px;
}

.modal-ai-body::-webkit-scrollbar-thumb {
    background: #2ecc71;
    border-radius: 10px;
}

.modal-template-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.modal-template-item {
    background: #0f1a12;
    border-radius: 12px;
    padding: 12px 16px;
    cursor: pointer;
    transition: all 0.25s ease;
    border: 1px solid #2a4a2a;
}

.modal-template-item:hover {
    background: #1a2a1f;
    border-color: #2ecc71;
    transform: translateX(4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.modal-template-item:active {
    transform: scale(0.98);
}

.modal-template-text {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #c8e6d0;
}

.loading-templates {
    text-align: center;
    padding: 40px;
    color: #9fd49f;
    font-size: 0.9rem;
}

.loading-templates i {
    margin-right: 8px;
}

/* ================= THANK YOU POPUP ================= */
.thankyou-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    animation: popupFade 0.4s ease-out;
}

@keyframes popupFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

.thankyou-content {
    background: linear-gradient(145deg, #0d1a0d, #1a3a1a);
    padding: 32px 36px;
    border-radius: 20px;
    max-width: 90%;
    width: 440px;
    text-align: center;
    border: 1px solid rgba(255, 215, 0, 0.06);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    animation: popupScale 0.4s ease-out;
}

@keyframes popupScale {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

.thankyou-content .icon {
    font-size: 56px;
    color: #FFD700;
    margin-bottom: 12px;
    display: block;
}

.thankyou-content h2 {
    color: #FFD700;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
}

.thankyou-content p {
    color: #b2d8b2;
    font-size: 14px;
    line-height: 1.7;
}

.thankyou-content .highlight {
    background: rgba(255, 215, 0, 0.04);
    border: 1px solid rgba(255, 215, 0, 0.06);
    border-radius: 12px;
    padding: 12px;
    margin: 14px 0;
    color: #FFD700;
    font-weight: 600;
    font-size: 13px;
}

.thankyou-content .sub {
    color: #889988;
    font-size: 12px;
    margin-bottom: 16px;
}

.thankyou-content button {
    background: linear-gradient(135deg, #1a4a1a, #2d6a2d);
    border: 1px solid rgba(76, 175, 80, 0.1);
    border-radius: 12px;
    padding: 12px 24px;
    color: #fff;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    font-family: 'Segoe UI', Arial, sans-serif;
}

.thankyou-content button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.15);
} 
/* ===== End of popup.css ===== */ 
 
 
/* ========================================== */ 
/*   File: responsive.css                                */ 
/* ========================================== */ 
/* ================================================================
   RESPONSIVE.CSS - RESPONSIVE
   ================================================================ */

@media (max-width: 768px) {
    .container {
        padding: 14px;
        border-radius: 14px;
        margin: 10px;
    }
    
    .dukops-header-row {
        flex-direction: column;
        text-align: center;
        gap: 12px;
    }
    
    .dukops-title-area {
        text-align: center;
    }
    
    .dukops-profile-area {
        width: 80px;
    }
    
    .dukops-profile-img {
        height: 70px;
    }
    
    .dukops-header-title {
        font-size: 16px;
    }
    
    .dukops-header-title:last-of-type {
        font-size: 13px;
    }
    
    .nav-buttons {
        gap: 6px;
        padding: 4px;
    }
    
    .nav-btn {
        font-size: 11px;
        padding: 10px 12px;
    }
    
    .nav-btn i {
        font-size: 14px;
    }
    
    .absen-stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .splash-title-center {
        font-size: 26px;
    }
    
    .splash-title-center:last-of-type {
        font-size: 18px;
    }
    
    .thankyou-content {
        padding: 24px;
        width: 92%;
    }
}

@media (max-width: 480px) {
    .container {
        padding: 10px;
        border-radius: 12px;
        margin: 6px;
    }
    
    .dukops-header {
        padding: 12px 14px;
    }
    
    .dukops-profile-area {
        width: 70px;
        padding: 4px;
    }
    
    .dukops-profile-img {
        height: 60px;
    }
    
    .dukops-profile-name {
        font-size: 9px;
    }
    
    .dukops-header-title {
        font-size: 14px;
    }
    
    .dukops-header-title:last-of-type {
        font-size: 12px;
    }
    
    .dukops-header-address {
        font-size: 9px;
    }
    
    .audio-control-wrapper {
        padding: 2px 8px;
    }
    
    .audio-volume-slider {
        width: 60px;
    }
    
    .counter-value {
        font-size: 14px;
        padding: 1px 10px;
    }
    
    .nav-buttons {
        flex-wrap: wrap;
        gap: 4px;
    }
    
    .nav-btn {
        font-size: 10px;
        padding: 8px 10px;
        flex: 1 1 30%;
    }
    
    .nav-btn i {
        font-size: 12px;
    }
    
    /* ================================================================
       TELEGRAM RESPONSIVE - DIHAPUS
       ================================================================ */
    
    .dukops-announcement-bar {
        font-size: 10px;
        padding: 6px 0;
    }
    
    .dukops-announcement-text {
        animation-duration: 15s;
    }
    
    .running-text-container {
        padding: 6px 12px;
    }
    
    .running-text {
        font-size: 11px;
        animation-duration: 10s;
    }
    
    .action-buttons {
        flex-direction: column;
    }
    
    .action-buttons button {
        width: 100%;
        min-width: auto;
        font-size: 12px;
    }
    
    .jadwal-section {
        padding: 12px;
    }
    
    .jadwal-section h3 {
        font-size: 13px;
    }
    
    .jadwal-title {
        font-size: 18px;
    }
    
    #j_hasilPesanBaru {
        font-size: 11px;
        min-height: 120px;
        padding: 10px;
    }
    
    .absen-stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 6px;
    }
    
    .absen-stat-value {
        font-size: 1.1rem;
    }
    
    .absen-desa-item {
        flex-wrap: wrap;
        gap: 6px;
        padding: 6px 8px;
    }
    
    .absen-desa-name {
        flex: 1 1 100%;
        font-size: 0.7rem;
    }
    
    .absen-desa-progress {
        min-width: 50px;
    }
    
    .absen-status-badge {
        font-size: 0.5rem;
        min-width: 50px;
        padding: 1px 6px;
    }
    
    .splash-title-center {
        font-size: 22px;
    }
    
    .splash-title-center:last-of-type {
        font-size: 16px;
    }
    
    .splash-logo-center img {
        width: 60px;
    }
    
    .splash-progress-center {
        width: 150px;
    }
    
    .modal-ai-content {
        width: 98%;
        height: 90vh;
        border-radius: 14px;
    }
    
    .modal-template-text {
        font-size: 0.7rem;
    }
    
    .modal-ai-header h3 {
        font-size: 1rem;
    }
    
    #categorySelect {
        font-size: 12px;
        padding: 8px 10px;
    }
    
    .thankyou-content {
        padding: 20px;
    }
    
    .thankyou-content .icon {
        font-size: 48px;
    }
    
    .thankyou-content h2 {
        font-size: 20px;
    }
    
    .thankyou-content p {
        font-size: 13px;
    }
    
    .led-letter {
        font-size: 16px;
        padding: 0 2px;
    }
    
    .led-running-text {
        animation-duration: 10s;
    }
    
    .knight-rider-text {
        font-size: 12px;
    }
    
    .knight-rider-container {
        padding: 6px 12px;
        border-radius: 20px;
    }
}

@media (max-width: 360px) {
    .dukops-profile-area {
        width: 60px;
    }
    
    .dukops-profile-img {
        height: 50px;
    }
    
    .dukops-header-title {
        font-size: 12px;
    }
    
    .dukops-header-title:last-of-type {
        font-size: 10px;
    }
    
    .dukops-header-address {
        font-size: 8px;
    }
    
    .counter-value {
        font-size: 12px;
        padding: 1px 8px;
    }
    
    .audio-control-btn {
        width: 26px;
        height: 26px;
        font-size: 11px;
    }
    
    .nav-btn {
        font-size: 9px;
        padding: 6px 6px;
        gap: 3px;
    }
    
    .nav-btn i {
        font-size: 10px;
    }
    
    .absen-btn {
        font-size: 10px;
        padding: 6px 10px;
    }
    
    .jadwal-title {
        font-size: 16px;
    }
} 
/* ===== End of responsive.css ===== */ 
 
 
/* ========================================== */ 
/*   File: splash.css                                */ 
/* ========================================== */ 
/* ================================================================
   SPLASH.CSS - SPLASH SCREEN
   ================================================================ */

.splash-container-modern {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #050d1a 0%, #0a1a3a 40%, #0d2a4a 70%, #0a1a2a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.8s ease, transform 0.8s ease;
}

.splash-container-modern::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse at center, rgba(255, 215, 0, 0.03) 0%, transparent 70%);
    animation: splashGlow 6s ease-in-out infinite;
}

@keyframes splashGlow {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.2); opacity: 1; }
}

.splash-content {
    text-align: center;
    padding: 20px;
    max-width: 400px;
    position: relative;
    z-index: 1;
    animation: splashFadeUp 0.8s ease-out;
}

@keyframes splashFadeUp {
    from { opacity: 0; transform: translateY(40px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.splash-logo-center img {
    width: 90px;
    height: auto;
    filter: drop-shadow(0 0 30px rgba(255, 215, 0, 0.2));
    animation: splashPulse 2s ease-in-out infinite;
}

@keyframes splashPulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.05); opacity: 1; filter: drop-shadow(0 0 40px rgba(255, 215, 0, 0.3)); }
}

.splash-title-center {
    font-size: 34px;
    font-weight: 800;
    color: #FFD700;
    letter-spacing: 4px;
    margin: 5px 0;
    text-shadow: 0 0 30px rgba(255, 215, 0, 0.15);
}

.splash-title-center:last-of-type {
    font-size: 20px;
    color: #FFC107;
    letter-spacing: 2px;
}

.splash-divider-center {
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, transparent, #FFD700, transparent);
    margin: 10px auto;
    border-radius: 3px;
}

.splash-subtitle-center {
    font-size: 12px;
    color: #88aacc;
    letter-spacing: 2px;
    margin-top: 8px;
    text-transform: uppercase;
}

.splash-unit-center {
    font-size: 14px;
    color: #aaccee;
    font-weight: 500;
    margin-top: 12px;
    letter-spacing: 1px;
}

.splash-kodim-center {
    font-size: 11px;
    color: #6688aa;
    margin-top: 4px;
}

.splash-progress-center {
    width: 200px;
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    margin: 25px auto 10px;
    overflow: hidden;
    position: relative;
}

.splash-progress-bar-center {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #FFD700, #FFA500);
    border-radius: 4px;
    transition: width 0.3s ease;
    position: relative;
}

.splash-progress-bar-center::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: progressShine 1.5s infinite;
}

@keyframes progressShine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

.splash-percentage-center {
    font-size: 12px;
    color: #FFD700;
    font-weight: bold;
    letter-spacing: 1px;
} 
/* ===== End of splash.css ===== */ 
 
 
/* ========================================== */ 
/*   File: tab-absen.css                                */ 
/* ========================================== */ 
/* ================================================================
   TAB-ABSEN.CSS - TAB ABSENSI
   ================================================================ */

.absen-card {
    background: rgba(0, 40, 0, 0.2);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 16px;
    border: 1px solid rgba(76, 175, 80, 0.04);
    backdrop-filter: blur(4px);
}

.absen-card select {
    background: rgba(0, 0, 0, 0.2);
    border-color: rgba(76, 175, 80, 0.06);
    margin-top: 4px;
}

.absen-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 16px 0;
}

.absen-stat-card {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    padding: 12px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.02);
}

.absen-stat-value {
    font-size: 1.4rem;
    font-weight: 700;
}

.absen-stat-label {
    font-size: 0.65rem;
    color: #889988;
    margin-top: 2px;
}

.absen-progress-container {
    margin: 12px 0;
}

.absen-progress-bar {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    height: 6px;
    overflow: hidden;
}

.absen-progress-fill {
    background: linear-gradient(90deg, #4CAF50, #8bc34a);
    height: 100%;
    width: 0%;
    border-radius: 10px;
    transition: width 0.6s ease;
}

.absen-desa-list {
    max-height: none;
    overflow-y: visible;
}

.absen-desa-item {
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 6px;
    padding: 8px 10px;
}

.absen-desa-item:hover {
    background: rgba(255, 255, 255, 0.02);
}

.absen-desa-name {
    flex: 2;
    font-size: 0.8rem;
    font-weight: 500;
}

.absen-desa-stats {
    min-width: 45px;
    font-size: 0.7rem;
    text-align: center;
    color: #889988;
}

.absen-desa-progress {
    flex: 1;
    min-width: 60px;
}

.absen-desa-progress-bar {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 5px;
    height: 4px;
}

.absen-desa-progress-fill {
    height: 4px;
    border-radius: 5px;
    transition: width 0.6s ease;
}

.absen-status-badge {
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 0.55rem;
    font-weight: 600;
    min-width: 60px;
    text-align: center;
    letter-spacing: 0.5px;
}

.absen-status-lengkap {
    background: rgba(27, 94, 32, 0.3);
    color: #a5d6a7;
    border: 1px solid rgba(27, 94, 32, 0.1);
}

.absen-status-belum-lengkap {
    background: rgba(230, 81, 0, 0.2);
    color: #ffcc80;
    border: 1px solid rgba(230, 81, 0, 0.1);
}

.absen-status-belum {
    background: rgba(183, 28, 28, 0.2);
    color: #ef9a9a;
    border: 1px solid rgba(183, 28, 28, 0.1);
}

.absen-btn {
    background: rgba(255, 255, 255, 0.03);
    color: #ddeedd;
    border: 1px solid rgba(76, 175, 80, 0.06);
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    transition: all 0.3s ease;
    font-family: 'Segoe UI', Arial, sans-serif;
}

.absen-btn:hover {
    background: rgba(76, 175, 80, 0.05);
    border-color: rgba(76, 175, 80, 0.1);
}

.absen-btn-primary {
    background: linear-gradient(135deg, #1a4a7a, #2d6a9a);
    border-color: rgba(52, 152, 219, 0.1);
}

.absen-btn-primary:hover {
    background: linear-gradient(135deg, #2d6a9a, #3d8aba);
}

.button-row-absen {
    display: flex;
    gap: 10px;
    margin: 12px 0;
}

.button-row-absen button {
    flex: 1;
    margin: 0;
}

.absen-loading {
    text-align: center;
    padding: 30px;
    color: #4dff4d;
}

.absen-spinner {
    display: inline-block;
    width: 30px;
    height: 30px;
    border: 3px solid rgba(76, 175, 80, 0.05);
    border-top-color: #4CAF50;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

.absen-info-text {
    text-align: center;
    font-size: 0.6rem;
    margin-top: 12px;
    color: #889988;
    letter-spacing: 0.5px;
} 
/* ===== End of tab-absen.css ===== */ 
 
 
/* ========================================== */ 
/*   File: telegram-running-container.css                                */ 
/* ========================================== */ 
/* ============ RUNNING TEXT PENERIMA PESAN TELEGRAM ============ */
.telegram-running-container {
    background: rgba(0, 0, 0, 0.7);
    border-radius: 40px;
    padding: 10px 18px;
    margin-bottom: 16px;
    border: 1px solid #ffcc00;
    overflow: hidden;
    white-space: nowrap;
}

.telegram-running-text {
    display: inline-block;
    white-space: nowrap;
    animation: telegramMarquee 13s linear infinite;
    color: #ffdd44;
    font-weight: bold;
    font-size: 14px;
    padding-right: 50px;
}

@keyframes telegramMarquee {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
}

.telegram-running-container:hover .telegram-running-text {
    animation-play-state: paused;
} 
/* ===== End of telegram-running-container.css ===== */ 
 
 
/* ========================================== */ 
/*   File: terang-besar.css                                */ 
/* ========================================== */ 
/* ============================================
   TAMPILAN TERANG & FONT BESAR
   ============================================ */

/* ----- DASAR ----- */
* {
    font-size: 28px;
}

body {
    background: #edf2f9 !important;
    color: #0a1a2e !important;
}

.container {
    background: #ffffff !important;
    max-width: 500px !important;
    padding: 16px !important;
}

/* ----- HEADER ----- */
.dukops-header {
    background: linear-gradient(135deg, #dce8f8, #b8cce8) !important;
    border-bottom: 3px solid #2a6a9a !important;
    padding: 18px 16px !important;
    border-radius: 14px 14px 0 0 !important;
}

.dukops-header-title {
    font-size: 1.8rem !important;
    font-weight: 700 !important;
    color: #0a1a3a !important;
    text-shadow: 0 1px 2px rgba(255,255,255,0.5) !important;
}

.dukops-header-address {
    font-size: 1rem !important;
    color: #1a2a4a !important;
}

/* ----- LABEL & INPUT ----- */
label {
    font-size: 1.2rem !important;
    font-weight: 600 !important;
    color: #0a1a3a !important;
    margin-top: 14px !important;
    display: block !important;
}

select, input, textarea {
    font-size: 1.15rem !important;
    padding: 14px 18px !important;
    border-radius: 12px !important;
    border: 2px solid #c8d8e8 !important;
    background: #faffff !important;
    width: 100% !important;
}

select:focus, input:focus, textarea:focus {
    border-color: #2a7acc !important;
    box-shadow: 0 0 0 4px rgba(42, 122, 204, 0.15) !important;
}

/* ----- PREVIEW BOX ----- */
.previewBox {
    background: #f5f9ff !important;
    border: 2px solid #dce6f0 !important;
    border-radius: 14px !important;
    padding: 18px 20px !important;
    margin: 6px 0 14px 0 !important;
    font-size: 1.1rem !important;
    color: #0a1a2e !important;
}

/* ----- TEXTAREA ----- */
textarea#narasi {
    font-size: 1.15rem !important;
    line-height: 1.9 !important;
    padding: 18px !important;
    min-height: 200px !important;
}

/* ----- TOMBOL ----- */
button, .nav-btn {
    font-size: 1.15rem !important;
    padding: 16px 26px !important;
    border-radius: 14px !important;
    font-weight: 600 !important;
}

#submitBtn {
    background: #1a6a3a !important;
    color: #ffffff !important;
    font-size: 1.2rem !important;
    padding: 18px 28px !important;
}

#resetBtn {
    background: #e8ecf0 !important;
    color: #1a2a3a !important;
    font-size: 1.1rem !important;
}

/* ----- RUNNING TEXT ----- */
.telegram-running-container {
    background: #dce8f8 !important;
    padding: 8px 0 !important;
}

.telegram-running-text {
    font-size: 1.3rem !important;
    font-weight: 600 !important;
    color: #0a1a3a !important;
    padding: 14px 0 !important;
}

/* ----- COUNTER ----- */
.counter-value {
    font-size: 1.6rem !important;
    font-weight: 800 !important;
    color: #0a1a3a !important;
    background: #ffd700 !important;
    padding: 4px 18px !important;
    border-radius: 30px !important;
}

/* ----- JADWAL PIKET ----- */
.jadwal-title {
    font-size: 2.2rem !important;
    font-weight: 800 !important;
    color: #0a1a3a !important;
}

.jadwal-section {
    background: #f5f9ff !important;
    border: 2px solid #dce6f0 !important;
    border-radius: 16px !important;
    padding: 20px !important;
    margin: 12px 0 !important;
}

.section-title-koramil,
.section-title-kediaman,
.section-title-makodim {
    font-size: 1.3rem !important;
    font-weight: 700 !important;
    color: #0a1a3a !important;
}

/* ----- ABSENSI ----- */
.absen-card {
    background: #f5f9ff !important;
    border: 2px solid #dce6f0 !important;
    border-radius: 16px !important;
    padding: 20px !important;
}

.absen-stat-value {
    font-size: 2rem !important;
    font-weight: 800 !important;
}

.absen-desa-name {
    font-size: 1.1rem !important;
    font-weight: 600 !important;
}

/* ----- MODAL AI ----- */
.modal-ai-content {
    background: #ffffff !important;
    border-radius: 20px !important;
    padding: 24px !important;
}

.modal-ai-header h3 {
    font-size: 1.4rem !important;
    font-weight: 700 !important;
}

.modal-template-text {
    font-size: 1.1rem !important;
    line-height: 1.7 !important;
}

/* ----- ANNOUNCEMENT BAR ----- */
.dukops-announcement-bar {
    background: #1a2a4a !important;
    padding: 10px 0 !important;
}

.dukops-announcement-text {
    font-size: 1rem !important;
    color: #ffdd77 !important;
}
 
