/* ========================================== */ 
/*   File: attendance.css                                */ 
/* ========================================== */ 
/* ================================================================
   ATTENDANCE.CSS - ABSENSI
   ================================================================ */

#attendancePanel {
    margin-top: 20px;
    background: rgba(0, 0, 0, 0.2);
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

.attendance-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.attendance-header button {
    margin: 0;
    padding: 8px 16px;
    background: rgba(255, 50, 50, 0.08);
    border: 1px solid rgba(255, 50, 50, 0.1);
    border-radius: 8px;
    color: #ff6b6b;
    font-size: 12px;
    width: auto;
    cursor: pointer;
    transition: all 0.3s ease;
}

.attendance-header button:hover {
    background: rgba(255, 50, 50, 0.15);
}

.attendance-filters {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
}

.attendance-filters select,
.attendance-filters input {
    flex: 1;
    min-width: 120px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.04);
    background: rgba(0, 0, 0, 0.2);
    color: #ddeedd;
    font-size: 12px;
}

.attendance-summary {
    background: rgba(255, 255, 255, 0.02);
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 16px;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 13px;
}

.summary-row span:last-child {
    font-weight: 600;
    color: #FFD700;
}

.progress-container {
    background: rgba(255, 255, 255, 0.04);
    height: 6px;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 10px;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #4CAF50, #8bc34a);
    transition: width 0.6s ease;
    border-radius: 10px;
}

.desa-card {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    margin-bottom: 10px;
    overflow: hidden;
    border-left: 3px solid #4CAF50;
    transition: all 0.3s ease;
}

.desa-card:hover {
    background: rgba(255, 255, 255, 0.04);
}

.desa-card.incomplete {
    border-left-color: #FF9800;
}

.desa-header {
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}

.desa-name {
    font-weight: 600;
    color: #b2d8b2;
    font-size: 14px;
}

.desa-count {
    background: rgba(255, 255, 255, 0.04);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    color: #889988;
}

.desa-files {
    padding: 8px 14px 14px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.02);
}

.file-link {
    color: #4CAF50;
    text-decoration: none;
    font-size: 12px;
    display: inline-block;
    padding: 2px 10px;
    border-radius: 4px;
    transition: all 0.3s ease;
}

.file-link:hover {
    background: rgba(76, 175, 80, 0.05);
} 
/* ===== End of attendance.css ===== */ 
 
 
/* ========================================== */ 
/*   File: base.css                                */ 
/* ========================================== */ 
/* ================================================================
   BASE.CSS - RESET & BASE
   ================================================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #0a1a3a;
    --secondary: #1a3a6a;
    --accent: #FFD700;
    --success: #4CAF50;
    --bg-dark: #0a120a;
    --bg-card: #162016;
    --text-light: #e6ffe6;
    --text-muted: #889988;
    --border-glow: rgba(76, 175, 80, 0.3);
}

body {
    font-family: 'Segoe UI', 'Arial', sans-serif;
    background: var(--bg-dark);
    color: var(--text-light);
    line-height: 1.6;
    min-height: 100vh;
    background-image: 
        radial-gradient(ellipse at 10% 20%, rgba(26, 58, 106, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 90% 80%, rgba(26, 58, 106, 0.10) 0%, transparent 50%);
}

.container {
    display: none;
    max-width: 720px;
    margin: 0 auto;
    padding: 20px;
    background: rgba(22, 32, 22, 0.92);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    border: 1px solid rgba(76, 175, 80, 0.15);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    animation: fadeIn 0.6s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: #0a120a; }
::-webkit-scrollbar-thumb { background: #2ecc71; border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #4CAF50; } 
/* ===== End of base.css ===== */ 
 
 
/* ========================================== */ 
/*   File: buttons.css                                */ 
/* ========================================== */ 
/* ================================================================
   BUTTONS.CSS - TOMBOL
   ================================================================ */

button {
    margin-top: 16px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #1a4a1a, #2d6a2d);
    color: white;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    width: 100%;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 0.5px;
    border: 1px solid rgba(76, 175, 80, 0.1);
}

button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.15);
    background: linear-gradient(135deg, #2d6a2d, #3d8a3d);
}

button:disabled {
    background: #333;
    cursor: not-allowed;
    opacity: 0.4;
    transform: none !important;
    box-shadow: none !important;
}

button i {
    margin-right: 8px;
}

.action-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
}

.action-buttons button {
    width: auto;
    flex: 1;
    min-width: 120px;
    padding: 10px 16px;
    font-size: 13px;
}

.action-buttons button:first-child {
    background: linear-gradient(135deg, #1a4a1a, #2d6a2d);
    border-color: rgba(76, 175, 80, 0.2);
}

.action-buttons button:last-child {
    background: rgba(255, 50, 50, 0.08);
    border: 1px solid rgba(255, 50, 50, 0.15);
    color: #ff6b6b;
}

.action-buttons button:last-child:hover {
    background: rgba(255, 50, 50, 0.15);
    box-shadow: 0 8px 30px rgba(255, 50, 50, 0.1);
}

#installButton {
    position: fixed;
    bottom: 80px;
    right: 20px;
    background: linear-gradient(135deg, #4CAF50, #2d6a2d);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 12px 20px;
    font-weight: 600;
    cursor: pointer;
    z-index: 1000;
    box-shadow: 0 8px 30px rgba(76, 175, 80, 0.2);
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

#installButton:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 12px 40px rgba(76, 175, 80, 0.3);
} 
/* ===== End of buttons.css ===== */ 
 
 
/* ========================================== */ 
/*   File: chat-widget.css                                */ 
/* ========================================== */ 
/* ================================================================
   CHAT WIDGET — FLOATING BOTTOM-RIGHT
   Tema Hijau DUKOPS — Terintegrasi dengan aplikasi
   ================================================================ */

/* ================================================================
   CONTAINER WIDGET
   ================================================================ */
.chat-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

/* ================================================================
   TOMBOL BUKA CHAT (💬)
   ================================================================ */
.chat-toggle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(145deg, #1a472a, #2d6a3e);
    color: #f4f5c8;
    border: 2px solid #4dff4d;
    font-size: 28px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(46, 125, 50, 0.4);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.chat-toggle:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 30px rgba(46, 125, 50, 0.5);
}

.chat-toggle:active {
    transform: scale(0.95);
}

/* Badge notifikasi (jumlah pesan belum dibaca) */
.chat-toggle .badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #ef4444;
    color: white;
    font-size: 11px;
    font-weight: 700;
    min-width: 22px;
    height: 22px;
    border-radius: 11px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
    animation: badgePulse 1.5s ease-in-out infinite;
}

@keyframes badgePulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.chat-toggle .badge.show {
    display: flex;
}

/* ================================================================
   TOMBOL TUTUP CHAT (✕) — Muncul saat chat terbuka
   ================================================================ */
.chat-toggle-close {
    display: none;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(145deg, #1a472a, #2d6a3e);
    color: #f4f5c8;
    border: 2px solid #4dff4d;
    font-size: 28px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(46, 125, 50, 0.4);
    transition: all 0.3s ease;
    align-items: center;
    justify-content: center;
}

.chat-toggle-close:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 30px rgba(46, 125, 50, 0.5);
}

.chat-toggle-close:active {
    transform: scale(0.95);
}

/* Sembunyikan tombol buka saat chat terbuka, tampilkan tombol tutup */
.chat-widget.chat-open .chat-toggle {
    display: none;
}

.chat-widget.chat-open .chat-toggle-close {
    display: flex;
}

/* ================================================================
   CHAT BOX
   ================================================================ */
.chat-box {
    width: 380px;
    max-width: calc(100vw - 48px);
    height: 520px;
    max-height: calc(100vh - 120px);
    background: rgba(10, 30, 15, 0.95);
    border-radius: 16px;
    border: 1px solid rgba(77, 255, 77, 0.3);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    display: none;
    flex-direction: column;
    overflow: hidden;
    margin-bottom: 12px;
    animation: chatSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(8px);
}

.chat-box.open {
    display: flex;
}

@keyframes chatSlideUp {
    from {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* ================================================================
   HEADER CHAT
   ================================================================ */
.chat-header {
    background: linear-gradient(145deg, #1a472a, #0d2818);
    color: #f4f5c8;
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(77, 255, 77, 0.2);
}

.chat-header .title {
    font-size: 1em;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.chat-header .title .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    display: inline-block;
    animation: chatPulse 1.5s ease-in-out infinite;
}

@keyframes chatPulse {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.5;
        transform: scale(0.8);
    }
}

.chat-header .close-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f4f5c8;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
}

.chat-header .close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: scale(1.05);
}

.chat-header .close-btn:active {
    transform: scale(0.9);
}

/* ================================================================
   USER BAR
   ================================================================ */
.chat-user-bar {
    padding: 6px 18px;
    background: rgba(0, 40, 0, 0.6);
    font-size: 0.75em;
    color: #9fd49f;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(77, 255, 77, 0.1);
}

.chat-user-bar .user-name {
    font-weight: 600;
    color: #4dff4d;
}

.chat-user-bar .user-count {
    color: #8aaa8a;
}

.chat-user-bar .user-count i {
    color: #4dff4d;
    margin-right: 4px;
}

/* ================================================================
   MESSAGES AREA
   ================================================================ */
.chat-messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px;
    background: rgba(0, 20, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 4px;
}

/* Scrollbar styling */
.chat-messages-area::-webkit-scrollbar {
    width: 4px;
}

.chat-messages-area::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
}

.chat-messages-area::-webkit-scrollbar-thumb {
    background: #4dff4d;
    border-radius: 2px;
}

.chat-messages-area::-webkit-scrollbar-thumb:hover {
    background: #6aff6a;
}

/* ================================================================
   MESSAGE BUBBLES
   ================================================================ */
.chat-msg {
    max-width: 82%;
    padding: 8px 12px;
    border-radius: 14px;
    word-wrap: break-word;
    animation: chatFadeIn 0.25s ease;
}

@keyframes chatFadeIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Pesan sendiri (hijau) */
.chat-msg-own {
    background: linear-gradient(145deg, #1a472a, #2d6a3e);
    color: #f4f5c8;
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    border: 1px solid rgba(77, 255, 77, 0.2);
}

/* Pesan orang lain (abu-abu) */
.chat-msg-other {
    background: rgba(30, 50, 30, 0.85);
    color: #d4e6d4;
    align-self: flex-start;
    border-bottom-left-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* Pesan sistem */
.chat-msg-system {
    background: rgba(77, 255, 77, 0.06);
    color: #7aaa7a;
    align-self: center;
    font-size: 0.75em;
    padding: 6px 16px;
    border-radius: 20px;
    font-style: italic;
    max-width: 92%;
    text-align: center;
    border: 1px solid rgba(77, 255, 77, 0.06);
}

/* Pesan sistem error */
.chat-msg-system.error {
    color: #f87171;
    border-color: rgba(248, 113, 113, 0.2);
    background: rgba(248, 113, 113, 0.05);
}

/* Username di dalam pesan */
.chat-msg .msg-username {
    font-weight: 600;
    font-size: 0.75em;
    opacity: 0.8;
    display: block;
    margin-bottom: 1px;
}

.chat-msg-own .msg-username {
    color: #4dff4d;
    opacity: 0.9;
}

.chat-msg-other .msg-username {
    color: #9fd49f;
}

/* Konten pesan */
.chat-msg .msg-content {
    font-size: 0.9em;
    line-height: 1.4;
}

/* Waktu pesan */
.chat-msg .msg-time {
    font-size: 0.6em;
    opacity: 0.5;
    display: block;
    text-align: right;
    margin-top: 2px;
}

.chat-msg-own .msg-time {
    color: #b8d9b8;
}

.chat-msg-other .msg-time {
    color: #6a8a6a;
}

/* ================================================================
   TYPING INDICATOR
   ================================================================ */
.chat-typing {
    align-self: flex-start;
    color: #7aaa7a;
    font-size: 0.75em;
    padding: 4px 12px;
    background: rgba(0, 30, 0, 0.5);
    border-radius: 16px;
    display: none;
    animation: chatFadeIn 0.25s ease;
    border: 1px solid rgba(77, 255, 77, 0.08);
}

.chat-typing.show {
    display: block;
}

.chat-typing-dots span {
    animation: chatDotBounce 1.4s infinite;
    display: inline-block;
}

.chat-typing-dots span:nth-child(2) {
    animation-delay: 0.2s;
}

.chat-typing-dots span:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes chatDotBounce {
    0%, 60%, 100% {
        transform: translateY(0);
    }
    30% {
        transform: translateY(-5px);
    }
}

/* ================================================================
   INPUT AREA (Style WhatsApp)
   ================================================================ */
.chat-input-area {
    padding: 10px 16px 14px;
    background: rgba(0, 20, 0, 0.85);
    border-top: 1px solid rgba(77, 255, 77, 0.1);
    display: flex;
    gap: 10px;
    flex-shrink: 0;
    align-items: center;
}

.chat-input-area input {
    flex: 1;
    padding: 10px 16px;
    border: 1px solid rgba(77, 255, 77, 0.2);
    border-radius: 24px;
    font-size: 0.9em;
    outline: none;
    transition: all 0.3s;
    background: rgba(0, 25, 0, 0.6);
    color: #e6ffe6;
}

.chat-input-area input::placeholder {
    color: #4a6a4a;
    font-size: 0.85em;
}

.chat-input-area input:focus {
    border-color: #4dff4d;
    box-shadow: 0 0 0 3px rgba(77, 255, 77, 0.1);
}

.chat-input-area input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Tombol kirim seperti WhatsApp (ikon paper plane) */
.chat-input-area .send-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(145deg, #1a472a, #2d6a3e);
    color: #f4f5c8;
    border: 1px solid #4dff4d;
    font-size: 18px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.chat-input-area .send-btn:hover:not(:disabled) {
    transform: scale(1.08);
    box-shadow: 0 4px 15px rgba(46, 125, 50, 0.35);
    background: linear-gradient(145deg, #2d6a3e, #1a472a);
}

.chat-input-area .send-btn:active:not(:disabled) {
    transform: scale(0.92);
}

.chat-input-area .send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 500px) {
    .chat-box {
        width: calc(100vw - 32px);
        height: 480px;
        max-height: calc(100vh - 100px);
        border-radius: 16px;
    }

    .chat-widget {
        bottom: 16px;
        right: 16px;
    }

    .chat-toggle,
    .chat-toggle-close {
        width: 52px;
        height: 52px;
        font-size: 24px;
    }

    .chat-input-area input {
        font-size: 0.8em;
        padding: 8px 12px;
    }

    .chat-input-area .send-btn {
        width: 38px;
        height: 38px;
        font-size: 15px;
    }

    .chat-header .title {
        font-size: 0.85em;
    }

    .chat-msg {
        max-width: 88%;
        padding: 6px 10px;
    }

    .chat-msg .msg-content {
        font-size: 0.85em;
    }

    .chat-messages-area {
        padding: 8px 10px;
    }
}

/* Untuk tablet kecil */
@media (min-width: 501px) and (max-width: 768px) {
    .chat-box {
        width: 340px;
        height: 480px;
    }

    .chat-toggle,
    .chat-toggle-close {
        width: 56px;
        height: 56px;
        font-size: 26px;
    }
}

/* Untuk layar sangat kecil (landscape phone) */
@media (max-height: 600px) and (orientation: landscape) {
    .chat-box {
        height: 80vh;
        max-height: 350px;
    }

    .chat-messages-area {
        padding: 6px 10px;
    }

    .chat-msg {
        padding: 4px 8px;
    }

    .chat-msg .msg-content {
        font-size: 0.8em;
    }

    .chat-header {
        padding: 8px 12px;
    }

    .chat-user-bar {
        padding: 3px 12px;
        font-size: 0.65em;
    }

    .chat-input-area {
        padding: 6px 10px 8px;
    }

    .chat-input-area input {
        padding: 6px 12px;
        font-size: 0.8em;
    }

    .chat-input-area .send-btn {
        width: 32px;
        height: 32px;
        font-size: 13px;
    }
}

/* ================================================================
   ANIMASI UNTUK PESAN BARU
   ================================================================ */
.chat-msg-new {
    animation: chatBounceIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes chatBounceIn {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* ================================================================
   STATUS KONEKSI (Opsional untuk di header)
   ================================================================ */
.chat-status {
    font-size: 0.7em;
    color: #7aaa7a;
    display: flex;
    align-items: center;
    gap: 4px;
}

.chat-status .online {
    color: #4ade80;
}

.chat-status .offline {
    color: #f87171;
}

.chat-status .connecting {
    color: #fbbf24;
    animation: chatPulse 1s ease-in-out infinite;
}
 
/* ===== End of chat-widget.css ===== */ 
 
 
